---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Modal from "../components/Modal.astro";
import { withBasePath } from "../lib/paths";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  headerOverlay?: boolean;
}

const {
  title = "Торговый Дом А-Транс",
  description = "Торговый Дом А-Транс — поставка трансформаторного и подстанционного оборудования для промышленных объектов.",
  headerOverlay = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL(withBasePath("images/social-preview.png"), Astro.site);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" sizes="64x64" href={withBasePath("favicon.png")} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBasePath("apple-touch-icon.png")} />

    <meta property="og:locale" content="ru_RU" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Торговый Дом А-Транс" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Торговый Дом А-Транс" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
  </head>
  <body>
    <Header overlay={headerOverlay} />
    <slot />
    <script>
      import "../scripts/count-up";
    </script>
    <script is:inline>
      (() => {
        const revealItems = Array.from(document.querySelectorAll("[data-reveal]"));

        if (revealItems.length === 0) {
          return;
        }

        const canReveal =
          "IntersectionObserver" in window &&
          !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        if (!canReveal) {
          revealItems.forEach((item) => item.classList.add("is-revealed"));
          return;
        }

        document.documentElement.classList.add("reveal-motion");

        const observer = new IntersectionObserver(
          (entries, currentObserver) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) {
                return;
              }

              entry.target.classList.add("is-revealed");
              currentObserver.unobserve(entry.target);
            });
          },
          {
            rootMargin: "0px 0px -12% 0px",
            threshold: 0.14,
          },
        );

        revealItems.forEach((item) => {
          const rect = item.getBoundingClientRect();
          const isInInitialViewport = rect.top < window.innerHeight * 0.82 && rect.bottom > 0;

          if (isInInitialViewport) {
            item.classList.add("is-revealed");
            return;
          }

          observer.observe(item);
        });
      })();
    </script>
    <Footer />
    <Modal />
  </body>
</html>
