---
import BaseLayout from "../../layouts/BaseLayout.astro";

const phone = "+7 (495) 74-99-103";
const phoneHref = "tel:+74957499103";
const email = "info@alageum.pro";
const emailHref = `mailto:${email}`;
const address = "Москва, ул. Генерала Белова, д. 26";
const mapQuery = encodeURIComponent(address);
const mapSrc = `https://yandex.ru/map-widget/v1/?text=${mapQuery}&z=16`;
---

<BaseLayout
  title="Контакты ТД Алагеум Электрик Рус"
  description="Телефон, email и адрес ТД Алагеум Электрик Рус. Связь по вопросам подбора и поставки трансформаторов, КТП и подстанционного оборудования Alageum Electric."
>
  <main class="contacts-page">
    <section class="contacts-hero" aria-labelledby="contacts-title">
      <div class="container contacts-hero-inner">
        <div class="contacts-copy">
          <span class="contacts-kicker">Контакты</span>
          <h1 id="contacts-title">Свяжитесь с нами</h1>
          <p>
            Направьте запрос, спецификацию или опросный лист. Специалисты помогут с подбором
            трансформаторного и подстанционного оборудования Alageum Electric для проекта.
          </p>

          <div class="contacts-actions" aria-label="Быстрые действия">
            <a class="contacts-button contacts-button-primary" href={phoneHref}><span>Позвонить</span></a>
            <a class="contacts-button contacts-button-secondary" href={emailHref}><span>Написать на email</span></a>
          </div>
        </div>

        <aside class="contacts-summary" aria-label="Основные контакты">
          <span class="summary-label">Связь с отделом поставок</span>
          <a class="summary-phone" href={phoneHref}>{phone}</a>
          <a class="summary-mail" href={emailHref}>{email}</a>
          <p>Работаем с запросами по оборудованию для энергетики, промышленности и инфраструктуры.</p>
        </aside>
      </div>
    </section>

    <section class="contacts-info" aria-labelledby="contacts-info-title">
      <div class="container contacts-info-inner">
        <div class="contacts-info-head">
          <span class="contacts-kicker">Как обратиться</span>
          <h2 id="contacts-info-title">Данные для связи</h2>
        </div>

        <div class="contacts-list">
          <article class="contact-item">
            <span class="contact-item-label">Телефон</span>
            <a href={phoneHref}>{phone}</a>
            <p>Для первичного запроса и уточнения состава оборудования.</p>
          </article>

          <article class="contact-item">
            <span class="contact-item-label">Email</span>
            <a href={emailHref}>{email}</a>
            <p>Для спецификаций, опросных листов и материалов по проекту.</p>
          </article>

          <article class="contact-item">
            <span class="contact-item-label">Адрес</span>
            <address>{address}</address>
            <p>Встречу лучше согласовать заранее, чтобы специалист подготовил материалы.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="contacts-map-section" aria-labelledby="contacts-map-title">
      <div class="container contacts-map-head">
        <div>
          <span class="contacts-kicker">Карта</span>
          <h2 id="contacts-map-title">Наш адрес</h2>
        </div>
      </div>

      <div class="container contacts-map-shell">
        <iframe
          class="contacts-map"
          src={mapSrc}
          title={`Яндекс Карта: ${address}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .contacts-page {
    background: var(--color-bg);
  }

  .contacts-hero {
    padding: clamp(58px, 8vw, 112px) 0 clamp(64px, 8vw, 110px);
    background: var(--color-bg);
  }

  .contacts-hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(470px, 0.82fr);
    gap: clamp(34px, 7vw, 92px);
    align-items: end;
  }

  .contacts-copy {
    min-width: 0;
  }

  .contacts-kicker {
    display: inline-flex;
    margin-bottom: 20px;
    color: var(--color-industrial-red);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 820;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .contacts-copy h1,
  .contacts-info-head h2,
  .contacts-map-head h2 {
    margin: 0;
    color: var(--color-heading);
    font-weight: 920;
    text-transform: uppercase;
  }

  .contacts-copy h1 {
    max-width: 920px;
    font-size: clamp(2.35rem, 5.2vw, 5.35rem);
    line-height: 0.94;
  }

  .contacts-copy p {
    max-width: 680px;
    margin: 26px 0 0;
    color: #3b4453;
    font-size: clamp(1.02rem, 1.45vw, 1.17rem);
    line-height: 1.64;
  }

  .contacts-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .contacts-button {
    --button-cut: 12px;
    --button-inner-cut: 10px;

    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 13px 22px;
    overflow: hidden;
    clip-path: polygon(
      var(--button-cut) 0,
      100% 0,
      100% calc(100% - var(--button-cut)),
      calc(100% - var(--button-cut)) 100%,
      0 100%,
      0 var(--button-cut)
    );
    font-size: 0.95rem;
    font-weight: 840;
    transition:
      background 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .contacts-button:hover,
  .contacts-button:focus-visible {
    transform: translateY(-1px);
  }

  .contacts-button span {
    position: relative;
    z-index: 1;
  }

  .contacts-button-primary {
    background: var(--color-industrial-red);
    color: #ffffff;
  }

  .contacts-button-primary:hover,
  .contacts-button-primary:focus-visible {
    background: var(--color-heading);
  }

  .contacts-button-secondary {
    background: var(--color-heading);
    color: var(--color-heading);
  }

  .contacts-button-secondary::after {
    content: "";
    position: absolute;
    inset: 2px;
    z-index: 0;
    background: var(--color-bg);
    clip-path: polygon(
      var(--button-inner-cut) 0,
      100% 0,
      100% calc(100% - var(--button-inner-cut)),
      calc(100% - var(--button-inner-cut)) 100%,
      0 100%,
      0 var(--button-inner-cut)
    );
    transition: background 180ms ease;
  }

  .contacts-button-secondary:hover,
  .contacts-button-secondary:focus-visible {
    background: var(--color-heading);
    color: #ffffff;
  }

  .contacts-button-secondary:hover::after,
  .contacts-button-secondary:focus-visible::after {
    background: var(--color-heading);
  }

  .contacts-summary {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: clamp(300px, 28vw, 380px);
    padding: clamp(24px, 3vw, 34px);
    background: var(--color-industrial-red);
    color: #ffffff;
    clip-path: polygon(22px 0, 100% 0, 100% calc(100% - 22px), calc(100% - 22px) 100%, 0 100%, 0 22px);
  }

  .summary-label {
    display: block;
    color: rgba(255, 255, 255, 0.74);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 760;
    text-transform: uppercase;
  }

  .summary-phone,
  .summary-mail {
    display: block;
    color: #ffffff;
  }

  .summary-phone {
    margin-top: 24px;
    font-family: var(--font-mono);
    font-size: clamp(1.32rem, 2.6vw, 2.1rem);
    font-weight: 860;
    line-height: 1.08;
    white-space: nowrap;
  }

  .summary-mail {
    margin-top: 14px;
    color: rgba(255, 255, 255, 0.86);
    font-size: 1rem;
  }

  .contacts-summary p {
    margin: auto 0 0;
    color: rgba(255, 255, 255, 0.76);
    font-size: 0.96rem;
    line-height: 1.58;
  }

  .contacts-info {
    padding: clamp(68px, 8vw, 112px) 0;
  }

  .contacts-info-inner {
    display: grid;
    grid-template-columns: minmax(240px, 0.42fr) minmax(0, 1fr);
    gap: clamp(34px, 6vw, 82px);
    align-items: start;
  }

  .contacts-info-head h2,
  .contacts-map-head h2 {
    font-size: clamp(1.85rem, 3.3vw, 3.35rem);
    line-height: 0.98;
  }

  .contacts-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid rgba(15, 23, 42, 0.18);
  }

  .contact-item {
    min-width: 0;
    padding: 26px 24px 28px 0;
    border-bottom: 1px solid rgba(15, 23, 42, 0.18);
  }

  .contact-item + .contact-item {
    padding-left: 24px;
    border-left: 1px solid rgba(15, 23, 42, 0.18);
  }

  .contact-item-label {
    display: block;
    color: var(--color-industrial-red);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 820;
    text-transform: uppercase;
  }

  .contact-item a,
  .contact-item address {
    display: block;
    margin-top: 16px;
    color: var(--color-heading);
    font-style: normal;
    font-size: clamp(1rem, 1.35vw, 1.16rem);
    font-weight: 820;
    line-height: 1.3;
  }

  .contact-item a:hover,
  .contact-item a:focus-visible {
    color: var(--color-industrial-red);
  }

  .contact-item p {
    margin: 14px 0 0;
    color: var(--color-muted);
    font-size: 0.94rem;
    line-height: 1.52;
  }

  .contacts-map-section {
    padding: 0 0 clamp(72px, 9vw, 128px);
  }

  .contacts-map-head {
    margin-bottom: 24px;
  }

  .contacts-map-shell {
    --map-cut: 34px;
    --map-border-width: 2px;
    --map-inner-cut: calc(var(--map-cut) - var(--map-border-width));

    position: relative;
    overflow: hidden;
    padding: var(--map-border-width);
    background: var(--color-heading);
    clip-path: polygon(
      var(--map-cut) 0,
      100% 0,
      100% calc(100% - var(--map-cut)),
      calc(100% - var(--map-cut)) 100%,
      0 100%,
      0 var(--map-cut)
    );
  }

  .contacts-map {
    display: block;
    width: 100%;
    min-height: clamp(380px, 45vw, 560px);
    border: 0;
    clip-path: polygon(
      var(--map-inner-cut) 0,
      100% 0,
      100% calc(100% - var(--map-inner-cut)),
      calc(100% - var(--map-inner-cut)) 100%,
      0 100%,
      0 var(--map-inner-cut)
    );
    filter: saturate(0.88) contrast(1.02);
  }

  @media (max-width: 960px) {
    .contacts-hero-inner,
    .contacts-info-inner {
      grid-template-columns: 1fr;
    }

    .contacts-summary {
      max-width: 560px;
    }

    .contacts-list {
      grid-template-columns: 1fr;
    }

    .contact-item,
    .contact-item + .contact-item {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (max-width: 640px) {
    .contacts-hero {
      padding-top: 48px;
    }

    .contacts-copy h1 {
      font-size: clamp(2rem, 10.5vw, 3.05rem);
    }

    .contacts-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .contacts-button {
      width: 100%;
    }

    .summary-phone {
      font-size: clamp(1.2rem, 6vw, 1.55rem);
      white-space: normal;
    }

    .contacts-map-shell {
      --map-cut: 22px;

      width: 100%;
    }

    .contacts-map {
      min-height: 360px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contacts-button,
    .contacts-button-secondary::after {
      transition: none;
    }
  }
</style>
