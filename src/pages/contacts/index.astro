---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  companyEmail,
  companyEmailHref,
  managerMaxUrl,
  managerPhone,
  managerPhoneHref,
  officeAddress,
  officeMapCenter,
} from "../../data/contact";

const phone = managerPhone;
const phoneHref = managerPhoneHref;
const email = companyEmail;
const emailHref = companyEmailHref;
const address = officeAddress;
const mapQuery = "Ленинская Слобода 26";
const mapParams = new URLSearchParams({
  ll: officeMapCenter,
  mode: "search",
  text: mapQuery,
  z: "17",
});
const mapSrc = `https://yandex.ru/map-widget/v1/?${mapParams}`;
---

<BaseLayout
  title="Контакты | Торговый Дом А-Транс"
  description="Телефон, email и адрес компании «Торговый Дом А-Транс». Связь по вопросам подбора и поставки трансформаторов, КТП и подстанционного оборудования Alageum Electric."
>
  <main class="contacts-page">
    <section class="contacts-hero" aria-labelledby="contacts-title">
      <div class="container contacts-hero-inner">
        <div class="contacts-copy">
          <h1 class="page-title" id="contacts-title">Свяжитесь с нами</h1>
          <p>
            Направьте запрос, спецификацию или опросный лист. Специалисты помогут с подбором
            трансформаторного и подстанционного оборудования Alageum Electric для проекта.
          </p>

          <div class="contacts-actions" aria-label="Быстрые действия">
            <a class="button" href={phoneHref}><span>Позвонить</span></a>
            <a class="button button-outline" href={managerMaxUrl} target="_blank" rel="noopener noreferrer"><span>Написать в MAX</span></a>
          </div>
        </div>

        <aside class="contacts-summary" aria-label="Основные контакты">
          <span class="summary-label">Связь с отделом поставок</span>
          <a class="summary-phone" href={phoneHref}>{phone}</a>
          <a class="summary-mail" href={emailHref}>{email}</a>
          <p>Работаем с запросами по оборудованию для энергетики, промышленности и инфраструктуры.</p>
        </aside>
      </div>
    </section>

    <section class="contacts-info" aria-labelledby="contacts-info-title">
      <div class="container contacts-info-inner">
        <div class="contacts-info-head">
          <h2 class="section-title" id="contacts-info-title">Данные для связи</h2>
        </div>

        <div class="contacts-list">
          <article class="contact-item">
            <span class="contact-item-label">Телефон</span>
            <a href={phoneHref}>{phone}</a>
            <p>Для первичного запроса и уточнения состава оборудования.</p>
          </article>

          <article class="contact-item">
            <span class="contact-item-label">Email</span>
            <a href={emailHref}>{email}</a>
            <p>Для спецификаций, опросных листов и материалов по проекту.</p>
          </article>

          <article class="contact-item">
            <span class="contact-item-label">Адрес</span>
            <address>{address}</address>
            <p>Встречу лучше согласовать заранее, чтобы специалист подготовил материалы.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="contacts-map-section" aria-labelledby="contacts-map-title">
      <div class="container contacts-map-head">
        <div>
          <h2 class="section-title" id="contacts-map-title">Наш адрес</h2>
        </div>
      </div>

      <div class="container contacts-map-shell">
        <iframe
          class="contacts-map"
          src={mapSrc}
          title={`Яндекс Карта: ${address}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
.contacts-hero { padding-top: var(--space-section); }
  .contacts-hero-inner { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: clamp(36px, 7vw, 96px); align-items: start; }
  .contacts-copy h1 { margin: 0; }
  .contacts-copy p { max-width: 620px; margin: 24px 0 0; color: var(--color-muted); line-height: 1.7; }
  .contacts-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .contacts-summary { padding: 32px; background: var(--color-surface); }
  .summary-label { color: var(--color-muted); font-size: 0.85rem; }
  .summary-phone, .summary-mail { display: block; width: fit-content; }
  .summary-phone { margin-top: 24px; font-size: clamp(1.1rem, 1.65vw, 1.6rem); font-weight: 800; white-space: nowrap; }
  .summary-mail { margin-top: 12px; }
  .contacts-summary p { margin: 24px 0 0; color: var(--color-muted); font-size: 0.9rem; line-height: 1.6; }
  .contacts-info { padding-top: var(--space-section); }
  .contacts-info-head h2, .contacts-map-head h2 { margin: 0; }
  .contacts-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin-top: 32px; }
  .contact-item { min-width: 0; border-top: 1px solid var(--color-border); padding-top: 24px; }
  .contact-item-label { color: var(--color-muted); font-size: 0.85rem; }
  .contact-item a, .contact-item address { display: block; margin-top: 14px; font-size: 1.05rem; font-weight: 750; font-style: normal; line-height: 1.4; overflow-wrap: anywhere; }
  .contact-item a:hover, .contacts-summary a:hover { color: var(--color-industrial-red); }
  .contact-item p { margin: 12px 0 0; color: var(--color-muted); font-size: 0.9rem; line-height: 1.6; }
  .contacts-map-section { padding-top: var(--space-section); }
  .contacts-map-head { margin-bottom: 32px; }
  .contacts-map { display: block; width: 100%; height: clamp(320px, 40vw, 520px); border: 0; }
  @media (max-width: 900px) { .contacts-hero-inner { grid-template-columns: 1fr; } }
  @media (max-width: 640px) { .contacts-summary { padding: 24px; } .contacts-list { grid-template-columns: 1fr; gap: 24px; } .contacts-actions { flex-direction: column; } }
</style>
