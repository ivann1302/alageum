---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBasePath } from "../../lib/paths";

const catalogItems = [
  {
    title: "Масляные трансформаторы",
    range: "25-2500 кВА",
    voltage: "6/10 кВ",
    image: withBasePath("images/catalog-power-transformers.webp"),
    imageAlt: "Масляный силовой трансформатор Alageum Electric",
    lead: "Распределительные трансформаторы для сетей и промышленных объектов.",
    series: "ТМ, ТМГ, ТМГС, ТМГФ, ТМЭГ, ТМЗ, ОМ/ОМП",
  },
  {
    title: "Сухие трансформаторы",
    range: "по ТЗ",
    voltage: "6-10 кВ",
    image: withBasePath("images/catalog-distribution-transformers.webp"),
    imageAlt: "Сухой трансформатор Alageum Electric",
    lead: "Решения для внутренних помещений и объектов с повышенными требованиями к безопасности.",
    series: "ТСЛ(З), ТС(З)",
  },
  {
    title: "Комплектные подстанции",
    range: "под проект",
    voltage: "6-35 кВ",
    image: withBasePath("images/catalog-substations.webp"),
    imageAlt: "Комплектная трансформаторная подстанция",
    lead: "КТП для приема, преобразования и распределения электроэнергии на объекте.",
    series: "КТП, БКТП, 2КТП",
  },
  {
    title: "Трансформаторы тока",
    range: "по запросу",
    voltage: "6-35 кВ",
    image: withBasePath("images/catalog-distribution-transformers.webp"),
    imageAlt: "Измерительное трансформаторное оборудование",
    lead: "Измерительные трансформаторы для подстанционных и распределительных проектов.",
    series: "ТОЛ, ТПЛ",
  },
  {
    title: "Трансформаторы напряжения",
    range: "по запросу",
    voltage: "6-35 кВ",
    image: withBasePath("images/catalog-power-transformers.webp"),
    imageAlt: "Подстанционное трансформаторное оборудование",
    lead: "Оборудование для измерения и контроля напряжения в электрических сетях.",
    series: "НАМИ, НТМИ",
  },
  {
    title: "Подстанционное оборудование",
    range: "по проекту",
    voltage: "0,4-110 кВ",
    image: withBasePath("images/catalog-substations.webp"),
    imageAlt: "Подстанционное электротехническое оборудование",
    lead: "Высоковольтное и низковольтное оборудование под состав проектной поставки.",
    series: "РУВН, РУНН, разъединители, реакторы",
  },
];

const catalogSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Каталог оборудования — Торговый Дом А-Транс",
  description:
    "Каталог трансформаторов, комплектных подстанций и подстанционного оборудования Alageum Electric для сетей 6-110 кВ.",
  url: new URL(withBasePath("catalog/"), Astro.site),
  mainEntity: {
    "@type": "ItemList",
    itemListElement: catalogItems.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.title,
    })),
  },
};
---

<BaseLayout
  title="Каталог оборудования Alageum Electric | Торговый Дом А-Транс"
  description="Каталог трансформаторов, комплектных трансформаторных подстанций и подстанционного оборудования Alageum Electric для сетей 6-110 кВ."
>
  <main class="catalog-page">
    <section class="container catalog-section" aria-labelledby="catalog-title">
      <div class="catalog-heading">
        <h1 class="page-title" id="catalog-title">Каталог оборудования</h1>
      </div>

      <figure class="catalog-media" aria-live="polite">
        <img
          src={catalogItems[0].image}
          alt={catalogItems[0].imageAlt}
          loading="eager"
          decoding="async"
          data-catalog-image
        />

        <figcaption class="catalog-caption">
          <strong data-catalog-title>{catalogItems[0].title}</strong>
          <em data-catalog-meta>{catalogItems[0].range} · {catalogItems[0].voltage}</em>
        </figcaption>

        <p class="catalog-description" data-catalog-description>
          {catalogItems[0].lead}
        </p>

        <p class="catalog-series" data-catalog-series>
          <span>Серии</span>
          {catalogItems[0].series}
        </p>
      </figure>

      <div class="catalog-tabs" role="list" aria-label="Категории продукции">
        {
          catalogItems.map((item, index) => (
            <button
              class={`catalog-tab${index === 0 ? " is-active" : ""}`}
              type="button"
              aria-pressed={index === 0 ? "true" : "false"}
              data-catalog-tab
              data-index={String(index)}
            >
              <strong>{item.title}</strong>
            </button>
          ))
        }
      </div>
    </section>
  </main>

  <script
    is:inline
    type="application/json"
    id="catalog-data"
    set:html={JSON.stringify(catalogItems)}
  />

  <script is:inline>
    (() => {
      const dataElement = document.getElementById("catalog-data");
      const tabs = Array.from(document.querySelectorAll("[data-catalog-tab]"));
      const image = document.querySelector("[data-catalog-image]");
      const title = document.querySelector("[data-catalog-title]");
      const meta = document.querySelector("[data-catalog-meta]");
      const description = document.querySelector("[data-catalog-description]");
      const series = document.querySelector("[data-catalog-series]");

      if (
        !dataElement ||
        !(image instanceof HTMLImageElement) ||
        !(title instanceof HTMLElement) ||
        !(meta instanceof HTMLElement) ||
        !(description instanceof HTMLElement) ||
        !(series instanceof HTMLElement)
      ) {
        return;
      }

      const items = JSON.parse(dataElement.textContent || "[]");

      const activate = (index) => {
        const item = items[index];

        if (!item) {
          return;
        }

        tabs.forEach((tab, tabIndex) => {
          const isActive = tabIndex === index;
          tab.classList.toggle("is-active", isActive);
          tab.setAttribute("aria-pressed", String(isActive));
        });

        image.src = item.image;
        image.alt = item.imageAlt;
        title.textContent = item.title;
        meta.textContent = `${item.range} · ${item.voltage}`;
        description.textContent = item.lead;
        series.innerHTML = `<span>Серии</span>${item.series}`;
      };

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          activate(Number(tab.getAttribute("data-index")));
        });
      });
    })();
  </script>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(catalogSchema)} />
</BaseLayout>

<style>
.catalog-page { padding: var(--space-section) 0 0; }
  .catalog-section { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr); grid-template-areas: "heading heading" "media tabs"; gap: 40px; align-items: start; }
  .catalog-heading { grid-area: heading; }
  .catalog-heading h1 { margin: 0; }
  .catalog-media { grid-area: media; display: flex; flex-direction: column; margin: 0; padding: 28px; background: var(--color-surface); min-width: 0; }
  .catalog-media img { display: block; width: 100%; height: clamp(260px, 28vw, 400px); object-fit: contain; margin-bottom: 28px; }
  .catalog-caption { display: flex; justify-content: space-between; align-items: start; flex-wrap: wrap; gap: 12px; padding-top: 24px; border-top: 1px solid var(--color-border); }
  .catalog-caption strong { max-width: 360px; font-size: 1.15rem; line-height: 1.3; }
  .catalog-caption em { color: var(--color-muted); font-size: 0.85rem; font-style: normal; }
  .catalog-description { margin: 18px 0 0; color: var(--color-muted); line-height: 1.6; }
  .catalog-series { margin: 16px 0 0; font-size: 0.9rem; line-height: 1.6; }
  .catalog-series :global(span) { margin-right: 8px; color: var(--color-muted); }
  .catalog-tabs { grid-area: tabs; display: grid; border-top: 1px solid var(--color-border); }
  .catalog-tab { padding: 24px 20px; width: 100%; border: 0; border-bottom: 1px solid var(--color-border); background: transparent; color: var(--color-heading); font: inherit; text-align: left; cursor: pointer; transition: color 180ms ease, background-color 180ms ease; }
  .catalog-tab strong { font-size: 1rem; font-weight: 750; line-height: 1.4; }
  .catalog-tab:hover { color: var(--color-industrial-red); background: var(--color-surface); }
  .catalog-tab.is-active { background: var(--color-industrial-red); color: #ffffff; }
  @media (max-width: 900px) { .catalog-section { grid-template-columns: 1fr; grid-template-areas: "heading" "tabs" "media"; gap: 28px; } }
  @media (max-width: 640px) { .catalog-media { padding: 20px; } .catalog-media img { height: 240px; } .catalog-tab { padding: 18px 16px; } }
  @media (prefers-reduced-motion: reduce) { .catalog-tab { transition: none; } }
</style>
