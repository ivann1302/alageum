---
import BaseLayout from "../../layouts/BaseLayout.astro";

const catalogItems = [
  {
    title: "Масляные трансформаторы",
    code: "01",
    range: "25-2500 кВА",
    voltage: "6/10 кВ",
    image: "/images/catalog-power-transformers.webp",
    imageAlt: "Масляный силовой трансформатор Alageum Electric",
    lead: "Распределительные трансформаторы для сетей и промышленных объектов.",
    series: "ТМ, ТМГ, ТМГС, ТМГФ, ТМЭГ, ТМЗ, ОМ/ОМП",
  },
  {
    title: "Сухие трансформаторы",
    code: "02",
    range: "по ТЗ",
    voltage: "6-10 кВ",
    image: "/images/catalog-distribution-transformers.webp",
    imageAlt: "Сухой трансформатор Alageum Electric",
    lead: "Решения для внутренних помещений и объектов с повышенными требованиями к безопасности.",
    series: "ТСЛ(З), ТС(З)",
  },
  {
    title: "Комплектные подстанции",
    code: "03",
    range: "под проект",
    voltage: "6-35 кВ",
    image: "/images/catalog-substations.webp",
    imageAlt: "Комплектная трансформаторная подстанция",
    lead: "КТП для приема, преобразования и распределения электроэнергии на объекте.",
    series: "КТП, БКТП, 2КТП",
  },
  {
    title: "Трансформаторы тока",
    code: "04",
    range: "по запросу",
    voltage: "6-35 кВ",
    image: "/images/catalog-distribution-transformers.webp",
    imageAlt: "Измерительное трансформаторное оборудование",
    lead: "Измерительные трансформаторы для подстанционных и распределительных проектов.",
    series: "ТОЛ, ТПЛ",
  },
  {
    title: "Трансформаторы напряжения",
    code: "05",
    range: "по запросу",
    voltage: "6-35 кВ",
    image: "/images/catalog-power-transformers.webp",
    imageAlt: "Подстанционное трансформаторное оборудование",
    lead: "Оборудование для измерения и контроля напряжения в электрических сетях.",
    series: "НАМИ, НТМИ",
  },
  {
    title: "Подстанционное оборудование",
    code: "06",
    range: "по проекту",
    voltage: "0,4-110 кВ",
    image: "/images/catalog-substations.webp",
    imageAlt: "Подстанционное электротехническое оборудование",
    lead: "Высоковольтное и низковольтное оборудование под состав проектной поставки.",
    series: "РУВН, РУНН, разъединители, реакторы",
  },
];

const catalogSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Каталог оборудования Alageum Electric",
  description:
    "Каталог трансформаторов, комплектных подстанций и подстанционного оборудования Alageum Electric для сетей 6-110 кВ.",
  url: "https://www.alageum.pro/catalog/",
  mainEntity: {
    "@type": "ItemList",
    itemListElement: catalogItems.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.title,
    })),
  },
};
---

<BaseLayout
  title="Каталог оборудования Alageum Electric | ТД Алагеум Электрик Рус"
  description="Каталог трансформаторов, комплектных трансформаторных подстанций и подстанционного оборудования Alageum Electric для сетей 6-110 кВ."
>
  <main class="catalog-page">
    <section class="catalog-section" aria-labelledby="catalog-title">
      <div class="catalog-heading">
        <p class="catalog-code">Alageum · каталог</p>
        <h1 id="catalog-title">Каталог оборудования</h1>
      </div>

      <figure class="catalog-media" aria-live="polite">
        <img
          src={catalogItems[0].image}
          alt={catalogItems[0].imageAlt}
          loading="eager"
          decoding="async"
          data-catalog-image
        />

        <figcaption class="catalog-caption">
          <span data-catalog-code>{catalogItems[0].code}</span>
          <strong data-catalog-title>{catalogItems[0].title}</strong>
          <em data-catalog-meta>{catalogItems[0].range} · {catalogItems[0].voltage}</em>
        </figcaption>

        <p class="catalog-description" data-catalog-description>
          {catalogItems[0].lead}
        </p>

        <p class="catalog-series" data-catalog-series>
          <span>Серии</span>
          {catalogItems[0].series}
        </p>
      </figure>

      <div class="catalog-tabs" role="list" aria-label="Категории продукции">
        {
          catalogItems.map((item, index) => (
            <button
              class={`catalog-tab${index === 0 ? " is-active" : ""}`}
              type="button"
              aria-pressed={index === 0 ? "true" : "false"}
              data-catalog-tab
              data-index={String(index)}
            >
              <span>{item.code}</span>
              <strong>{item.title}</strong>
            </button>
          ))
        }
      </div>
    </section>
  </main>

  <script
    is:inline
    type="application/json"
    id="catalog-data"
    set:html={JSON.stringify(catalogItems)}
  />

  <script is:inline>
    (() => {
      const dataElement = document.getElementById("catalog-data");
      const tabs = Array.from(document.querySelectorAll("[data-catalog-tab]"));
      const image = document.querySelector("[data-catalog-image]");
      const code = document.querySelector("[data-catalog-code]");
      const title = document.querySelector("[data-catalog-title]");
      const meta = document.querySelector("[data-catalog-meta]");
      const description = document.querySelector("[data-catalog-description]");
      const series = document.querySelector("[data-catalog-series]");
      const media = document.querySelector(".catalog-media");

      if (
        !dataElement ||
        !(image instanceof HTMLImageElement) ||
        !(code instanceof HTMLElement) ||
        !(title instanceof HTMLElement) ||
        !(meta instanceof HTMLElement) ||
        !(description instanceof HTMLElement) ||
        !(series instanceof HTMLElement)
      ) {
        return;
      }

      const items = JSON.parse(dataElement.textContent || "[]");

      const activate = (index) => {
        const item = items[index];

        if (!item) {
          return;
        }

        tabs.forEach((tab, tabIndex) => {
          const isActive = tabIndex === index;
          tab.classList.toggle("is-active", isActive);
          tab.setAttribute("aria-pressed", String(isActive));
        });

        media?.classList.remove("is-swapping");
        void media?.clientWidth;
        media?.classList.add("is-swapping");

        image.src = item.image;
        image.alt = item.imageAlt;
        code.textContent = item.code;
        title.textContent = item.title;
        meta.textContent = `${item.range} · ${item.voltage}`;
        description.textContent = item.lead;
        series.innerHTML = `<span>Серии</span>${item.series}`;
      };

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          activate(Number(tab.getAttribute("data-index")));
        });
      });
    })();
  </script>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(catalogSchema)} />
</BaseLayout>

<style>
  .catalog-page {
    position: relative;
    isolation: isolate;
    min-height: calc(100vh - 85px);
    overflow-x: clip;
    background: var(--color-bg);
  }

  .catalog-page::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      repeating-linear-gradient(
        -11deg,
        transparent 0,
        transparent 92px,
        rgba(200, 23, 31, 0.075) 92px,
        rgba(200, 23, 31, 0.075) 94px,
        transparent 94px,
        transparent 172px
      ),
      repeating-linear-gradient(
        -11deg,
        transparent 0,
        transparent 236px,
        rgba(15, 23, 42, 0.055) 236px,
        rgba(15, 23, 42, 0.055) 237px,
        transparent 237px,
        transparent 336px
      );
  }

  .catalog-section {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.72fr);
    grid-template-areas:
      "heading heading"
      "media tabs";
    align-items: start;
    gap: 28px clamp(34px, 4vw, 64px);
    min-height: calc(100vh - 85px);
    padding: clamp(36px, 5vw, 64px) clamp(20px, 5vw, 72px) clamp(64px, 8vw, 96px);
  }

  .catalog-heading {
    grid-area: heading;
    max-width: 640px;
  }

  .catalog-code {
    margin: 0;
    color: var(--color-industrial-red);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 860;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .catalog-heading h1 {
    max-width: 620px;
    margin: 12px 0 0;
    color: var(--color-heading);
    font-size: clamp(2.1rem, 3.25vw, 3.72rem);
    font-weight: 950;
    line-height: 0.92;
    letter-spacing: 0;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .catalog-tabs {
    grid-area: tabs;
    display: grid;
    grid-template-rows: repeat(6, minmax(0, 1fr));
    gap: 12px;
    align-content: start;
    height: 640px;
  }

  .catalog-tab {
    --tab-cut: 16px;
    --tab-border: var(--color-heading);
    --tab-border-width: 2px;
    --tab-inner-cut: calc(var(--tab-cut) - var(--tab-border-width));

    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    width: 100%;
    min-height: 0;
    padding: 22px 24px;
    border: 0;
    overflow: hidden;
    clip-path: polygon(
      var(--tab-cut) 0,
      100% 0,
      100% calc(100% - var(--tab-cut)),
      calc(100% - var(--tab-cut)) 100%,
      0 100%,
      0 var(--tab-cut)
    );
    background: var(--tab-border);
    color: var(--color-heading);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background-color 180ms ease,
      color 220ms ease,
      transform 180ms ease;
  }

  .catalog-tab::before {
    content: "";
    position: absolute;
    inset: var(--tab-border-width);
    z-index: -1;
    clip-path: polygon(
      var(--tab-inner-cut) 0,
      100% 0,
      100% calc(100% - var(--tab-inner-cut)),
      calc(100% - var(--tab-inner-cut)) 100%,
      0 100%,
      0 var(--tab-inner-cut)
    );
    background: #ffffff;
    pointer-events: none;
    transition: background-color 180ms ease;
  }

  .catalog-tab:hover,
  .catalog-tab:focus-visible,
  .catalog-tab.is-active {
    --tab-border: var(--color-industrial-red);

    color: #ffffff;
    transform: translateY(-1px);
  }

  .catalog-tab:hover::before,
  .catalog-tab:focus-visible::before,
  .catalog-tab.is-active::before {
    background: var(--color-industrial-red);
  }

  .catalog-tab span {
    color: rgba(15, 23, 42, 0.38);
    font-family: var(--font-mono);
    font-size: 1.18rem;
    font-weight: 900;
    line-height: 1;
    transition: color 220ms ease;
  }

  .catalog-tab:hover span,
  .catalog-tab:focus-visible span,
  .catalog-tab.is-active span {
    color: rgba(255, 255, 255, 0.84);
  }

  .catalog-tab strong {
    max-width: 330px;
    font-size: clamp(0.98rem, 1.12vw, 1.26rem);
    font-weight: 950;
    line-height: 1.12;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .catalog-media {
    --media-cut: 22px;
    --media-border-width: 2px;
    --media-inner-cut: calc(var(--media-cut) - var(--media-border-width));

    grid-area: media;
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    height: 640px;
    min-height: 640px;
    margin: 0;
    padding: clamp(18px, 2.4vw, 32px);
    overflow: hidden;
    background: var(--color-heading);
    clip-path: polygon(
      var(--media-cut) 0,
      100% 0,
      100% calc(100% - var(--media-cut)),
      calc(100% - var(--media-cut)) 100%,
      0 100%,
      0 var(--media-cut)
    );
  }

  .catalog-media::before {
    content: "";
    position: absolute;
    inset: var(--media-border-width);
    z-index: -1;
    background: #ffffff;
    clip-path: polygon(
      var(--media-inner-cut) 0,
      100% 0,
      100% calc(100% - var(--media-inner-cut)),
      calc(100% - var(--media-inner-cut)) 100%,
      0 100%,
      0 var(--media-inner-cut)
    );
    pointer-events: none;
  }

  .catalog-media.is-swapping img {
    animation: catalog-image-in 420ms cubic-bezier(0.18, 0.82, 0.2, 1);
  }

  .catalog-media img {
    display: block;
    width: 100%;
    max-width: 720px;
    height: 430px;
    object-fit: contain;
    filter: saturate(0.95) contrast(1.03) drop-shadow(0 18px 26px rgba(15, 23, 42, 0.12));
  }

  .catalog-caption {
    position: absolute;
    left: clamp(18px, 2.4vw, 32px);
    right: clamp(18px, 2.4vw, 32px);
    bottom: clamp(18px, 2.4vw, 32px);
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 54px;
    padding-top: 16px;
    border-top: 1px solid rgba(15, 23, 42, 0.16);
    background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.94) 26%);
    color: var(--color-heading);
  }

  .catalog-caption span {
    color: var(--color-industrial-red);
    font-family: var(--font-mono);
    font-size: 1.36rem;
    font-weight: 900;
    line-height: 1;
  }

  .catalog-caption strong {
    font-size: 0.92rem;
    font-weight: 950;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .catalog-caption em {
    margin-left: auto;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-style: normal;
    font-weight: 850;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .catalog-description,
  .catalog-series {
    position: absolute;
    left: clamp(18px, 2.4vw, 32px);
    max-width: min(460px, calc(100% - 64px));
    margin: 0;
    color: #3b4453;
    line-height: 1.5;
  }

  .catalog-description {
    top: clamp(18px, 2.4vw, 32px);
    font-size: clamp(1rem, 1.25vw, 1.12rem);
  }

  .catalog-series {
    top: calc(clamp(18px, 2.4vw, 32px) + 86px);
    color: var(--color-heading);
    font-size: 0.9rem;
    font-weight: 760;
    overflow-wrap: anywhere;
  }

  .catalog-series span {
    display: block;
    margin-bottom: 7px;
    color: var(--color-industrial-red);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 860;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @keyframes catalog-image-in {
    from {
      opacity: 0;
      transform: scale(0.97);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (min-width: 981px) {
    .catalog-heading h1 {
      font-size: clamp(2rem, 5vh, 3.35rem);
    }

    .catalog-tab {
      padding-block: clamp(14px, 2.2vh, 22px);
    }

    .catalog-media img {
      height: min(42vh, 430px);
    }
  }

  @media (max-width: 980px) {
    .catalog-section {
      grid-template-columns: 1fr;
      grid-template-areas:
        "heading"
        "media"
        "tabs";
      min-height: auto;
    }

    .catalog-media,
    .catalog-tabs {
      height: auto;
      min-height: 0;
    }

    .catalog-media {
      min-height: 560px;
    }

    .catalog-tabs {
      grid-template-rows: none;
    }

    .catalog-tab {
      min-height: 86px;
    }
  }

  @media (max-width: 620px) {
    .catalog-section {
      gap: 24px;
      padding: 38px 12px 72px;
    }

    .catalog-heading h1 {
      font-size: clamp(1.68rem, 7vw, 1.92rem);
    }

    .catalog-media {
      min-height: 520px;
      padding: 18px;
    }

    .catalog-media img {
      height: 260px;
      margin-top: 82px;
    }

    .catalog-caption {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
      min-height: 0;
    }

    .catalog-caption em {
      margin-left: 0;
      white-space: normal;
    }

    .catalog-description,
    .catalog-series {
      max-width: calc(100% - 36px);
    }

    .catalog-series {
      top: 118px;
      font-size: 0.82rem;
      line-height: 1.38;
    }

    .catalog-tab {
      grid-template-columns: 42px minmax(0, 1fr);
      min-height: 78px;
      padding: 18px 20px;
    }

    .catalog-tab strong {
      max-width: 100%;
      font-size: 0.9rem;
      line-height: 1.12;
    }

    .catalog-tab:hover,
    .catalog-tab:focus-visible,
    .catalog-tab.is-active {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .catalog-tab,
    .catalog-tab::before,
    .catalog-tab span,
    .catalog-media.is-swapping img {
      animation: none;
      transition: none;
    }
  }
</style>
