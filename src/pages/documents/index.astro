---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DocumentCard from "../../components/DocumentCard.astro";
import DocumentViewer from "../../components/DocumentViewer.astro";
import { documents } from "../../data/documents";

const documentationSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Документация на оборудование — Торговый Дом А-Транс",
  description: "Декларации соответствия и выписки из реестра ЕАЭС на трансформаторное и подстанционное оборудование.",
  url: new URL("/documents/", Astro.site),
  mainEntity: {
    "@type": "ItemList",
    itemListElement: documents.map((document, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: document.title,
      url: new URL(`/${document.file}`, Astro.site),
    })),
  },
};
---

<BaseLayout
  title="Документация на оборудование | Торговый Дом А-Транс"
  description="Декларации соответствия и выписки из реестра ЕАЭС на трансформаторы, подстанции и распределительное оборудование Торгового Дома А-Транс."
>
  <main class="documents-page">
    <section class="container documents-section" aria-labelledby="documents-title">
      <header class="documents-heading">
        <h1 class="page-title" id="documents-title">Документация</h1>
        <p>Откройте документ для просмотра или скачайте оригинал в формате PDF.</p>
      </header>

      <div class="document-grid">
        {documents.map((document, index) => (
          <DocumentCard document={document} priority={index < 3} headingLevel={2} />
        ))}
      </div>
    </section>
  </main>

  <DocumentViewer />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(documentationSchema)} />
</BaseLayout>

<style>
  .documents-page { padding-top: var(--space-section); }
  .documents-heading { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr); gap: clamp(32px, 7vw, 96px); align-items: end; }
  .documents-heading h1 { margin: 0; }
  .documents-heading p { max-width: 520px; margin: 0; color: var(--color-muted); line-height: 1.7; }
  .document-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(44px, 5vw, 64px) 36px; margin-top: clamp(44px, 6vw, 72px); }
  @media (max-width: 900px) {
    .document-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .documents-heading { grid-template-columns: 1fr; gap: 20px; }
    .document-grid { grid-template-columns: 1fr; gap: 40px; margin-top: 36px; }
  }
</style>
