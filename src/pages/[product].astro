---
import BaseLayout from "../layouts/BaseLayout.astro";
import { catalogSeries, type CatalogSeries } from "../data/catalog";
import { managerMaxUrl } from "../data/contact";
import { withBasePath } from "../lib/paths";

export function getStaticPaths() {
  return catalogSeries.map((series) => ({
    params: { product: series.id },
    props: { series },
  }));
}

interface Props {
  series: CatalogSeries;
}

const { series } = Astro.props;
const pagePath = `${series.id}/`;
const pageUrl = new URL(withBasePath(pagePath), Astro.site);
const imageUrl = new URL(withBasePath(series.image), Astro.site);
const metaDescription = `${series.subtitle}. ${series.description}`;

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      name: series.title,
      description: series.description,
      category: series.group,
      image: imageUrl,
      url: pageUrl,
      additionalProperty: series.specs.map((spec) => ({
        "@type": "PropertyValue",
        name: spec.label,
        value: spec.value,
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Главная",
          item: new URL(withBasePath(), Astro.site),
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Каталог",
          item: new URL(withBasePath("catalog/"), Astro.site),
        },
        {
          "@type": "ListItem",
          position: 3,
          name: series.title,
          item: pageUrl,
        },
      ],
    },
  ],
};
---

<BaseLayout
  title={`${series.title} — ${series.subtitle} | Торговый Дом А-Транс`}
  description={metaDescription}
>
  <main class="product-page">
    <nav class="container breadcrumbs" aria-label="Хлебные крошки">
      <ol>
        <li><a href={withBasePath()}>Главная</a></li>
        <li><a href={withBasePath("catalog/")}>Каталог</a></li>
        <li aria-current="page">{series.title}</li>
      </ol>
    </nav>

    <section class="container product-hero" aria-labelledby="product-title">
      <figure class="product-media">
        <img
          src={withBasePath(series.image)}
          alt={`${series.subtitle} ${series.title}, пример исполнения`}
          width="960"
          height="960"
          loading="eager"
          decoding="async"
        />
        <figcaption>Внешний вид и комплектация зависят от исполнения</figcaption>
      </figure>

      <div class="product-summary">
        <p class="product-group">{series.group}</p>
        <h1 class="page-title" id="product-title">{series.title}</h1>
        <p class="product-subtitle">{series.subtitle}</p>
        <p class="product-lead">{series.description}</p>

        <dl class="product-specs">
          {series.specs.map((spec) => (
            <div>
              <dt>{spec.label}</dt>
              <dd>{spec.value}</dd>
            </div>
          ))}
        </dl>

        <div class="product-actions">
          <a class="button" href={managerMaxUrl} target="_blank" rel="noopener noreferrer">Запросить подбор</a>
          <a class="button button-outline" href={withBasePath("catalog/")}>Вернуться в каталог</a>
        </div>
      </div>
    </section>

    <section class="container product-content" aria-labelledby="product-description-title" data-product-description>
      <div class="product-description">
        <h2 id="product-description-title">О серии {series.title}</h2>
        {series.details.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <div class="product-info-grid">
        <section>
          <h2>Особенности</h2>
          <ul>{series.features.map((feature) => <li>{feature}</li>)}</ul>
        </section>
        <section>
          <h2>Где применяется</h2>
          <ul>{series.applications.map((application) => <li>{application}</li>)}</ul>
        </section>
        <section>
          <h2>Что учесть при подборе</h2>
          <ul>{series.selection.map((item) => <li>{item}</li>)}</ul>
        </section>
      </div>

      <aside class="product-request">
        <div>
          <h2>Подберём исполнение по проекту</h2>
          <p>Пришлите однолинейную схему, опросный лист или основные параметры объекта. Уточним характеристики и подготовим предложение.</p>
        </div>
        <a class="button" href={managerMaxUrl} target="_blank" rel="noopener noreferrer">Запросить предложение</a>
      </aside>
    </section>
  </main>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
</BaseLayout>

<style>
  .product-page { padding: 32px 0 var(--space-section); }
  .breadcrumbs { margin-bottom: 40px; }
  .breadcrumbs ol { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; color: var(--color-muted); font-size: 0.82rem; list-style: none; }
  .breadcrumbs li:not(:last-child)::after { content: "/"; margin-left: 8px; }
  .breadcrumbs a:hover { color: var(--color-industrial-red); }
  .product-hero { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(320px, 0.88fr); gap: clamp(40px, 6vw, 80px); align-items: center; }
  .product-media { margin: 0; padding: clamp(24px, 4vw, 48px); background: var(--color-surface); }
  .product-media img { display: block; width: 100%; height: clamp(360px, 43vw, 560px); object-fit: contain; }
  .product-media figcaption { margin-top: 20px; color: var(--color-muted); font-size: 0.75rem; line-height: 1.5; text-align: center; }
  .product-group { margin: 0 0 16px; color: var(--color-industrial-red); font-size: 0.82rem; font-weight: 750; text-transform: uppercase; }
  .product-summary h1 { margin: 0; }
  .product-subtitle { margin: 18px 0 0; font-size: clamp(1.15rem, 2vw, 1.5rem); font-weight: 750; line-height: 1.35; }
  .product-lead { margin: 24px 0; color: var(--color-muted); line-height: 1.7; }
  .product-specs { margin: 0; border-top: 1px solid var(--color-border); }
  .product-specs div { display: grid; grid-template-columns: minmax(110px, 0.8fr) 1.2fr; gap: 20px; padding: 15px 0; border-bottom: 1px solid var(--color-border); font-size: 0.9rem; line-height: 1.5; }
  .product-specs dt { color: var(--color-muted); }
  .product-specs dd { margin: 0; font-weight: 700; }
  .product-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .product-content { padding-top: var(--space-section); }
  .product-description { max-width: 820px; }
  .product-description h2, .product-info-grid h2, .product-request h2 { margin: 0; font-size: clamp(1.5rem, 2.8vw, 2.2rem); line-height: 1.2; }
  .product-description p { margin: 22px 0 0; color: var(--color-muted); font-size: 1.02rem; line-height: 1.75; }
  .product-info-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px; margin-top: 64px; padding-top: 48px; border-top: 1px solid var(--color-border); }
  .product-info-grid h2 { font-size: 1.25rem; }
  .product-info-grid ul { margin: 20px 0 0; padding-left: 20px; line-height: 1.65; }
  .product-info-grid li + li { margin-top: 8px; }
  .product-info-grid li::marker { color: var(--color-industrial-red); }
  .product-request { display: flex; justify-content: space-between; align-items: center; gap: 40px; margin-top: 64px; padding: clamp(28px, 4vw, 48px); background: var(--color-industrial-red); color: #ffffff; }
  .product-request div { max-width: 700px; }
  .product-request p { margin: 16px 0 0; color: rgb(255 255 255 / 96%); line-height: 1.65; }
  .product-request .button { flex: none; border-color: #ffffff; background: #ffffff; color: #090909; }
  .product-request .button:hover { border-color: #090909; background: #090909; color: #ffffff; }
  @media (max-width: 900px) {
    .product-hero { grid-template-columns: 1fr; }
    .product-media img { height: min(70vw, 500px); }
    .product-info-grid { grid-template-columns: 1fr; gap: 36px; }
  }
  @media (max-width: 640px) {
    .product-page { padding-top: 20px; }
    .breadcrumbs { margin-bottom: 28px; }
    .product-hero { gap: 32px; }
    .product-media { padding: 20px; }
    .product-media img { height: 280px; }
    .product-specs div { grid-template-columns: 1fr; gap: 4px; }
    .product-actions { display: grid; }
    .product-content { padding-top: 56px; }
    .product-info-grid { margin-top: 48px; padding-top: 40px; }
    .product-request { align-items: stretch; flex-direction: column; margin-top: 48px; }
    .product-request .button { width: 100%; }
  }
</style>
