---
import Carousel from "./Carousel.astro";

const placeholders = Array.from({ length: 4 });
---

<Carousel
  id="documentation-slides"
  label="Документы. Листайте вбок или используйте клавиши со стрелками"
  previousLabel="Предыдущие документы"
  nextLabel="Следующие документы"
>
  {
    placeholders.map((_, index) => (
      <button
        class="documentation-placeholder"
        type="button"
        aria-label={`Открыть документ ${index + 1}`}
        data-carousel-item
        data-document-trigger
      ></button>
    ))
  }
</Carousel>

<dialog class="documentation-dialog" aria-labelledby="documentation-dialog-title" data-document-dialog>
  <div class="documentation-dialog-panel">
    <h2 class="sr-only" id="documentation-dialog-title">Просмотр документа</h2>
    <button class="documentation-dialog-close" type="button" aria-label="Закрыть документ" data-document-close></button>
    <div class="documentation-document" aria-hidden="true"></div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-document-dialog]");
  const triggers = document.querySelectorAll<HTMLButtonElement>("[data-document-trigger]");
  const closeButton = dialog?.querySelector<HTMLButtonElement>("[data-document-close]");

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => dialog?.showModal());
  });

  closeButton?.addEventListener("click", () => dialog?.close());
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>

<style>
  .documentation-placeholder { display: block; width: 100%; height: var(--carousel-media-height); padding: 0; border: 0; border-radius: 0; background: var(--color-surface); cursor: pointer; transition: background-color 180ms ease; }
  .documentation-placeholder:hover { background: #e5e5e5; }
  .documentation-dialog { width: min(94vw, 960px); max-width: none; height: min(90vh, 1120px); max-height: none; padding: 0; border: 0; background: transparent; overflow: visible; }
  .documentation-dialog::backdrop { background: rgb(0 0 0 / 72%); }
  .documentation-dialog-panel { position: relative; width: 100%; height: 100%; padding: 32px; background: transparent; }
  .documentation-document { width: min(100%, 760px); height: 100%; margin-inline: auto; background: #ffffff; }
  .documentation-dialog-close { position: absolute; z-index: 1; top: 0; right: 0; width: 44px; height: 44px; padding: 0; border: 0; border-radius: 0; background: var(--color-industrial-red); cursor: pointer; }
  .documentation-dialog-close::before, .documentation-dialog-close::after { content: ""; position: absolute; top: 21px; left: 12px; width: 20px; height: 2px; background: #ffffff; }
  .documentation-dialog-close::before { transform: rotate(45deg); }
  .documentation-dialog-close::after { transform: rotate(-45deg); }
  @media (max-width: 640px) {
    .documentation-dialog { width: 100vw; height: 100dvh; }
    .documentation-dialog-panel { padding: 56px 12px 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .documentation-placeholder { transition: none; }
  }
</style>
