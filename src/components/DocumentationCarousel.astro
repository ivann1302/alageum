---
import Carousel from "./Carousel.astro";
import DocumentCard from "./DocumentCard.astro";
import DocumentViewer from "./DocumentViewer.astro";
import { documents } from "../data/documents";
---

<div class="documentation-carousel">
  <Carousel
    id="documentation-slides"
    label="Документы. Листайте вбок или используйте клавиши со стрелками"
    previousLabel="Предыдущие документы"
    nextLabel="Следующие документы"
    showSwipeHint
  >
    {
      documents.map((document) => (
        <DocumentCard document={document} carousel />
      ))
    }
  </Carousel>
</div>

<DocumentViewer />

<style>
  .documentation-carousel :global(.carousel-frame) {
    display: grid;
    grid-template-columns: 52px minmax(0, 778px) 52px;
    column-gap: 12px;
    max-width: 906px;
    --carousel-media-height: clamp(240px, 24vw, 340px);
  }
  .documentation-carousel :global(.carousel-track) { grid-column: 2; grid-row: 1; }
  .documentation-carousel :global(.carousel-arrow) {
    position: static;
    grid-row: 1;
    align-self: start;
    margin-top: calc((var(--carousel-media-height) / 2) - 26px);
    transform: none;
  }
  .documentation-carousel :global(.carousel-arrow-prev) { grid-column: 1; justify-self: end; }
  .documentation-carousel :global(.carousel-arrow-next) { grid-column: 3; justify-self: start; }
  @media (max-width: 640px) {
    .documentation-carousel :global(.carousel-frame) {
      grid-template-columns: 44px minmax(0, 297px) 44px;
      column-gap: 4px;
      max-width: 393px;
      --carousel-media-height: min(100vw, 420px);
    }
    .documentation-carousel :global(.carousel-arrow) { margin-top: calc((var(--carousel-media-height) / 2) - 22px); }
  }
</style>
