---
import { withBasePath } from "../lib/paths";

const reasons = [
  {
    title: "Официальные поставки",
    text: "Работаем с оборудованием предприятий Alageum Electric и сопровождаем запрос до отгрузки.",
  },
  {
    title: "Подбор под проект",
    text: "Учитываем тип оборудования, мощность, напряжение, исполнение и условия установки.",
  },
  {
    title: "Документы и КП",
    text: "Готовим коммерческое предложение и техническую информацию для согласования.",
  },
  {
    title: "Логистика по России",
    text: "Согласуем поставку под сроки проекта и особенности промышленного объекта.",
  },
];
---

<section class="why-section" id="advantages" aria-labelledby="why-title">
  <div class="why-visual" data-parallax>
    <img src={withBasePath("images/advantages-power-line.webp")} width="1448" height="1086" alt="Опора линии электропередачи в поле" loading="lazy" decoding="async" />
  </div>
  <div class="why-body" data-reveal="panel" data-reveal-from="right">
    <h2 id="why-title">Поставка без лишних рисков</h2>
    <p class="why-lead">Помогаем пройти путь от проектного запроса до коммерческого предложения, документов и отгрузки.</p>
    <div class="why-list" aria-label="Преимущества работы с торговым домом">
      {reasons.map((reason) => (
        <article class="why-item">
          <h3>{reason.title}</h3>
          <p>{reason.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .why-section {
    display: grid;
    grid-template-columns: minmax(0, 0.76fr) minmax(0, 1.24fr);
    overflow: clip;
    width: 100%;
    margin: clamp(64px, 7vw, 104px) 0;
    background: #e30620;
    color: #ffffff;
  }

  .why-visual { position: relative; min-height: 540px; background: #d9d9d9; }
  .why-visual img { display: block; width: 100%; height: calc(100% + 2 * var(--parallax-space, 0px)); position: absolute; inset: calc(-1 * var(--parallax-space, 0px)) 0 auto; object-fit: cover; object-position: 52% center; }
  .why-body { align-self: center; min-width: 0; padding: clamp(36px, 5vw, 76px); }
  .why-body h2 { max-width: 600px; margin: 0; font-size: clamp(2rem, 3.2vw, 3.6rem); font-weight: 950; line-height: 1; letter-spacing: -0.025em; text-transform: uppercase; }
  .why-lead { max-width: 470px; margin: 22px 0 30px; font-size: 0.95rem; line-height: 1.6; }
  .why-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 32px; border-top: 1px solid rgba(255, 255, 255, 0.4); }
  .why-item { padding: 22px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.4); }
  .why-item h3 { margin: 0; font-size: 0.95rem; font-weight: 850; text-transform: uppercase; }
  .why-item p { margin: 10px 0 0; font-size: 0.85rem; line-height: 1.6; }

  @media (max-width: 900px) {
    .why-section { grid-template-columns: 1fr; }
    .why-visual { min-height: 340px; }
    .why-visual { aspect-ratio: 4 / 3; }
  }
  @media (max-width: 640px) {
    .why-section { margin: 48px 0; }
    .why-body { padding: 32px 24px; }
    .why-body h2 { font-size: clamp(1.75rem, 7.5vw, 2.6rem); }
    .why-list { grid-template-columns: 1fr; }
    .why-visual { min-height: 280px; }
  }
</style>
