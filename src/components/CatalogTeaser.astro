---
import { withBasePath } from "../lib/paths";
import Carousel from "./Carousel.astro";

import { catalogSeries } from "../data/catalog";

const catalogItems = catalogSeries.map((series) => ({
  title: series.title,
  image: withBasePath(series.image),
  imageAlt: series.subtitle,
  href: withBasePath(`catalog/#${series.id}`),
}));
---

<section class="catalog-teaser" aria-labelledby="catalog-teaser-title">
  <div class="container catalog-teaser-inner">
    <div class="catalog-teaser-head" data-reveal="panel">
      <div class="catalog-teaser-copy">
        <h2 class="section-title" id="catalog-teaser-title">Каталог оборудования</h2>
        <p>
          Основные направления поставки для промышленных, энергетических и
          инфраструктурных объектов.
        </p>
      </div>
    </div>
  </div>

  <Carousel
    id="catalog-slides"
    label="Основные серии каталога. Листайте вбок или используйте клавиши со стрелками"
    previousLabel="Предыдущие модели"
    nextLabel="Следующие модели"
    showSwipeHint
  >
    {
      catalogItems.map((item, index) => (
        <a
          class="catalog-card"
          href={item.href}
          aria-label={`Перейти в каталог: ${item.title}`}
          data-reveal="card"
          data-carousel-item
          style={`--reveal-delay: ${index * 80}ms;`}
        >
          <span class="catalog-card-frame">
            <span class="catalog-card-media">
              <img
                src={item.image}
                alt={item.imageAlt}
                loading="lazy"
                decoding="async"
                width="960"
                height="960"
              />
            </span>

            <span class="catalog-card-body">
              <span class="catalog-card-title">{item.title}</span>
            </span>
          </span>
        </a>
      ))
    }
  </Carousel>

  <div class="container catalog-teaser-footer">
    <a class="catalog-link button" href={withBasePath("catalog/")}>Перейти в каталог</a>
  </div>
</section>

<style>
.catalog-teaser { overflow: clip; }
  .catalog-teaser-head { display: flex; justify-content: space-between; align-items: end; gap: 32px; margin-bottom: 36px; }
  .catalog-teaser-copy { max-width: 700px; }
  .catalog-teaser h2 { margin: 0; }
  .catalog-teaser p { max-width: 560px; margin: 22px 0 0; color: var(--color-muted); line-height: 1.7; }
  .catalog-teaser-footer { display: flex; justify-content: center; margin-top: 32px; }
  .catalog-card { display: block; min-width: 0; }
  .catalog-card-frame { display: block; }
  .catalog-card-media { display: block; height: var(--carousel-media-height); background: var(--color-surface); overflow: hidden; }
  .catalog-card img { display: block; width: 100%; height: 100%; padding: 20px; object-fit: contain; }
  .catalog-card-body { display: block; padding: 14px 0 0; text-align: center; }
  .catalog-card-title { display: block; font-size: 1.1rem; font-weight: 800; line-height: 1.25; text-transform: uppercase; transition: color 180ms ease; }
  .catalog-card:hover .catalog-card-title { color: var(--color-industrial-red); }
  @media (max-width: 900px) {
    .catalog-teaser-head { align-items: start; flex-direction: column; }
  }
  @media (prefers-reduced-motion: reduce) {
    .catalog-card-title { transition: none; }
  }
</style>
