---
const catalogItems = [
  {
    title: "Силовые трансформаторы",
    description: "Оборудование для промышленных и энергетических объектов.",
    voltage: "35-110 кВ",
    image: "/images/catalog-power-transformers.webp",
    imageAlt: "Силовой трансформатор Alageum Electric",
    position: "center 58%",
  },
  {
    title: "Распределительные трансформаторы",
    description: "Решения для распределительных сетей и локальных объектов.",
    voltage: "6/10 кВ",
    image: "/images/catalog-distribution-transformers.webp",
    imageAlt: "Распределительный сухой трансформатор",
    position: "center center",
  },
  {
    title: "КТП и подстанции",
    description: "Комплектные решения под задачи объекта и условия установки.",
    voltage: "проект",
    image: "/images/catalog-substations.webp",
    imageAlt: "Комплектная трансформаторная подстанция",
    position: "center center",
  },
];
---

<section class="catalog-teaser" aria-labelledby="catalog-teaser-title">
  <div class="container catalog-teaser-inner">
    <div class="catalog-teaser-head" data-reveal="panel">
      <div class="catalog-teaser-copy">
        <h2 class="section-title" id="catalog-teaser-title">Каталог оборудования</h2>
        <p>
          Основные направления поставки для промышленных, энергетических и
          инфраструктурных объектов.
        </p>
      </div>

      <a class="catalog-link button" href="/catalog/">Перейти в каталог</a>
    </div>
  </div>

  <div class="container catalog-grid" aria-label="Основные разделы каталога">
    {
      catalogItems.map((item, index) => (
        <a
          class="catalog-card"
          href="/catalog/"
          aria-label={`Перейти в каталог: ${item.title}`}
          data-reveal="card"
          style={`--reveal-delay: ${index * 80}ms;`}
        >
          <span class="catalog-card-frame">
            <span class="catalog-card-media">
              <img
                src={item.image}
                alt={item.imageAlt}
                loading="lazy"
                decoding="async"
                style={`object-position: ${item.position};`}
              />
            </span>

            <span class="catalog-card-body">
              <span class="catalog-card-meta">
                <span>{item.voltage}</span>
              </span>
              <span class="catalog-card-title">{item.title}</span>
              <span class="catalog-card-text">{item.description}</span>
            </span>
          </span>
        </a>
      ))
    }
  </div>
</section>

<style>
.catalog-teaser { overflow: clip; }
  .catalog-teaser-head { display: flex; justify-content: space-between; align-items: end; gap: 32px; margin-bottom: 36px; }
  .catalog-teaser-copy { max-width: 700px; }
  .catalog-teaser h2 { margin: 0; }
  .catalog-teaser p { max-width: 560px; margin: 22px 0 0; color: var(--color-muted); line-height: 1.7; }
  .catalog-link { flex-shrink: 0; }
  .catalog-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  .catalog-card { display: block; min-width: 0; }
  .catalog-card-frame { display: block; }
  .catalog-card-media { display: block; height: clamp(220px, 23vw, 300px); background: var(--color-surface); overflow: hidden; }
  .catalog-card img { display: block; width: 100%; height: 100%; padding: 20px; object-fit: contain; }
  .catalog-card-body { display: grid; gap: 12px; padding: 24px 0 0; }
  .catalog-card-meta { color: var(--color-muted); font-size: 0.8rem; }
  .catalog-card-title { font-size: 1.1rem; font-weight: 800; line-height: 1.25; text-transform: uppercase; transition: color 180ms ease; }
  .catalog-card-text { color: var(--color-muted); font-size: 0.9rem; line-height: 1.6; }
  .catalog-card:hover .catalog-card-title { color: var(--color-industrial-red); }
  @media (max-width: 900px) {
    .catalog-teaser-head { align-items: start; flex-direction: column; }
    .catalog-grid { gap: 20px; }
  }
  @media (max-width: 640px) {
    .catalog-grid {
      width: 100%;
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 86%;
      gap: 16px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 12px;
      padding: 4px 12px 20px;
      scrollbar-width: thin;
      scrollbar-color: var(--color-primary) var(--color-border);
    }
    .catalog-card { scroll-snap-align: start; scroll-snap-stop: always; }
    .catalog-card-media { height: clamp(220px, 65vw, 280px); }
  }
  @media (prefers-reduced-motion: reduce) { .catalog-card-title { transition: none; } }
</style>
