---
import { withBasePath } from "../lib/paths";

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

const navItems = [
  { label: "Каталог", href: withBasePath("catalog/") },
  { label: "О компании", href: withBasePath("#about") },
  { label: "Поставка", href: withBasePath("#delivery") },
  { label: "Гарантия", href: withBasePath("#warranty") },
  { label: "Контакты", href: withBasePath("contacts/") },
];
---

<header class:list={["site-header", { "is-overlay": overlay }]} data-site-header>
  <div class="container header-inner">
    <a class="brand" href={withBasePath()} aria-label="ТД А-Транс, на главную">
      <svg class="brand-logo" viewBox="0 0 360 374" role="img" aria-label="Торговый дом А-Транс">
        <defs>
          <filter id="header-logo-dark" color-interpolation-filters="sRGB">
            <feColorMatrix type="matrix" values="1 -1 0 0 0.03  0 0 0 0 0.03  0 0 0 0 0.03  0 0 0 1 0" />
          </filter>
        </defs>
        <image href={withBasePath("images/footer-logo-atrans.png")} width="360" height="447" filter="url(#header-logo-dark)" />
      </svg>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="header-menu"
      data-nav-toggle
    >
      <span class="sr-only">Открыть меню</span>
      <span class="nav-toggle-line" aria-hidden="true"></span>
      <span class="nav-toggle-line" aria-hidden="true"></span>
      <span class="nav-toggle-line" aria-hidden="true"></span>
    </button>

    <div class="header-menu" id="header-menu" data-header-menu>
      <nav class="site-nav" id="site-navigation" aria-label="Основная навигация" data-site-nav>
        {navItems.map((item) => <a class="nav-link" href={item.href}>{item.label}</a>)}
      </nav>

      <div class="header-actions">
        <a class="phone-link" href="tel:+74957499103">+7 (495) 74-99-103</a>
        <a class="button button-dark" href={withBasePath("contacts/")}>
          <span>Запросить КП</span>
        </a>
      </div>
    </div>
  </div>

</header>

<script>
  const header = document.querySelector("[data-site-header]");
  const toggle = document.querySelector("[data-nav-toggle]");
  const menu = document.querySelector("[data-header-menu]");
  const toggleLabel = toggle?.querySelector(".sr-only");

  const setScrolledState = () => {
    if (!header) return;

    const isScrolled = header.classList.contains("is-scrolled");
    header.classList.toggle("is-scrolled", window.scrollY > (isScrolled ? 4 : 12));
  };

  const setViewportState = () => {
    if (!header) {
      return;
    }

    const width = window.innerWidth;

    header.classList.toggle("is-compact", width <= 1040);
    header.classList.toggle("is-phone", width <= 640);
    header.classList.toggle("is-tiny", width <= 420);

    if (toggle instanceof HTMLElement) {
      if (width <= 1040) {
        toggle.style.display = "inline-flex";
        toggle.style.position = "fixed";
        toggle.style.top = width <= 640 ? "14px" : "20px";
        toggle.style.right = "12px";
        toggle.style.width = "44px";
        toggle.style.height = "44px";
        toggle.style.border = "1px solid #cbd5e1";
        toggle.style.borderRadius = "8px";
        toggle.style.background = "#ffffff";
        toggle.style.color = "#0f172a";
        toggle.style.flexDirection = "column";
        toggle.style.alignItems = "center";
        toggle.style.justifyContent = "center";
        toggle.style.zIndex = "80";
      } else {
        toggle.removeAttribute("style");
      }
    }

    if (width > 1040) {
      closeMenu();
    }

    if (menu instanceof HTMLElement) {
      menu.inert = width <= 1040 && !header.classList.contains("is-menu-open");
    }
  };

  const closeMenu = () => {
    toggle?.setAttribute("aria-expanded", "false");
    header?.classList.remove("is-menu-open");
    if (toggleLabel) toggleLabel.textContent = "Открыть меню";
    if (menu instanceof HTMLElement) {
      if (menu.contains(document.activeElement) && toggle instanceof HTMLElement) {
        toggle.focus();
      }
      menu.inert = window.innerWidth <= 1040;
    }
  };

  setScrolledState();
  setViewportState();
  window.addEventListener("scroll", setScrolledState, { passive: true });
  window.addEventListener("resize", setViewportState);

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    if (isOpen) {
      closeMenu();
      return;
    }
    toggle.setAttribute("aria-expanded", "true");
    header?.classList.add("is-menu-open");
    if (toggleLabel) toggleLabel.textContent = "Закрыть меню";
    if (menu instanceof HTMLElement) menu.inert = false;
  });

  menu?.addEventListener("click", (event) => {
    if (event.target instanceof HTMLAnchorElement) {
      closeMenu();
    }
  });

  document.addEventListener("click", (event) => {
    if (event.target instanceof Node && !header?.contains(event.target)) {
      closeMenu();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeMenu();
    }
  });
</script>

<style>
  .site-header {
    --header-bg: rgba(255, 255, 255, 0.94);
    --header-border-color: rgba(219, 227, 238, 0.72);
    --header-clip: polygon(
      0 0,
      100% 0,
      100% 100%,
      calc(100% - 34px) 100%,
      calc(100% - 54px) 100%,
      54px 100%,
      34px 100%,
      0 100%
    );
    --header-edge-opacity: 0;
    --header-collapse: 0px;

    position: sticky;
    top: 0;
    z-index: 50;
    isolation: isolate;
    overflow: visible;
    min-height: 84px;
    border-bottom: 0;
    background: transparent;
  }

  .site-header.is-overlay {
    position: fixed;
    inset: 0 0 auto;
  }

  .site-header.is-overlay:not(.is-scrolled):not(.is-menu-open)::before {
    opacity: 0;
  }

  .site-header::before {
    content: "";
    position: absolute;
    inset: 0;
    bottom: var(--header-collapse);
    z-index: 0;
    background: var(--header-bg);
    box-shadow: inset 0 -1px var(--header-border-color);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    -webkit-clip-path: var(--header-clip);
    clip-path: var(--header-clip);
    pointer-events: none;
    opacity: 1;
    transition:
      opacity 240ms ease,
      background 180ms ease,
      bottom 180ms ease,
      box-shadow 180ms ease,
      -webkit-clip-path 220ms ease,
      clip-path 220ms ease;
  }

  .site-header::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(var(--header-collapse) - 2px);
    z-index: 2;
    height: 17px;
    background: var(--color-industrial-red);
    opacity: var(--header-edge-opacity);
    pointer-events: none;
    -webkit-clip-path: polygon(
      0 0,
      34px 0,
      54px 14px,
      calc(100% - 54px) 14px,
      calc(100% - 34px) 0,
      100% 0,
      100% 1.5px,
      calc(100% - 34.5px) 1.5px,
      calc(100% - 54.5px) 15.5px,
      54.5px 15.5px,
      34.5px 1.5px,
      0 1.5px
    );
    clip-path: polygon(
      0 0,
      34px 0,
      54px 14px,
      calc(100% - 54px) 14px,
      calc(100% - 34px) 0,
      100% 0,
      100% 1.5px,
      calc(100% - 34.5px) 1.5px,
      calc(100% - 54.5px) 15.5px,
      54.5px 15.5px,
      34.5px 1.5px,
      0 1.5px
    );
    transition: opacity 180ms ease, bottom 180ms ease;
  }

  .site-header.is-scrolled {
    --header-collapse: 16px;
    --header-bg: rgba(255, 255, 255, 0.98);
    --header-border-color: transparent;
    --header-edge-opacity: 1;
    --header-clip: polygon(
      0 0,
      100% 0,
      100% calc(100% - 14px),
      calc(100% - 34px) calc(100% - 14px),
      calc(100% - 54px) 100%,
      54px 100%,
      34px calc(100% - 14px),
      0 calc(100% - 14px)
    );
  }

  .header-inner {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 28px;
    min-height: 84px;
    transition: min-height 180ms ease;
  }

  .site-header.is-scrolled .header-inner {
    min-height: 68px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    color: var(--color-heading);
  }

  .brand-logo {
    overflow: hidden;
    flex: 0 0 auto;
    width: 48px;
    height: auto;
    display: block;
  }

  .header-menu {
    display: contents;
  }

  .site-nav {
    position: relative;
    justify-self: center;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 8px 12px;
    color: var(--color-muted);
    font-size: 0.94rem;
    font-weight: 720;
    white-space: nowrap;
    transition: color 160ms ease;
  }

  .nav-link::before {
    content: "";
    position: absolute;
    left: 12px;
    right: auto;
    bottom: 5px;
    width: calc(100% - 24px);
    height: 2px;
    background: var(--color-industrial-red);
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left;
    transition: opacity 160ms ease, transform 180ms ease;
  }

  .nav-link::after {
    content: none;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--color-heading);
  }

  .nav-link:hover::before,
  .nav-link:focus-visible::before {
    opacity: 1;
    transform: scaleX(1);
  }

  .header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 14px;
  }

  .phone-link {
    color: var(--color-heading);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 820;
    white-space: nowrap;
  }

  .phone-link:hover {
    color: var(--color-primary);
  }

  .nav-toggle {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    border: 1px solid #cbd5e1;
    border-radius: var(--radius-md);
    background: #ffffff;
    color: var(--color-heading);
    cursor: pointer;
  }

  .nav-toggle-line {
    display: block;
    width: 18px;
    height: 2px;
    margin: 4px auto;
    border-radius: 999px;
    background: currentColor;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .site-header.is-menu-open .nav-toggle span:nth-child(2) {
    transform: translateY(10px) rotate(45deg);
  }

  .site-header.is-menu-open .nav-toggle span:nth-child(3) {
    opacity: 0;
  }

  .site-header.is-menu-open .nav-toggle span:nth-child(4) {
    transform: translateY(-10px) rotate(-45deg);
  }

  .site-header.is-compact .header-inner {
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    padding-right: 60px;
  }

  .site-header.is-compact {
    --header-clip: none;
    --header-edge-opacity: 0;

    overflow: visible;
  }

  .site-header.is-compact .brand {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
  }

  .site-header.is-compact .nav-toggle {
    position: fixed;
    top: 20px;
    right: 12px;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 80;
  }

  .site-header.is-compact .header-menu {
    position: fixed;
    top: 84px;
    bottom: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
    width: min(420px, 100%);
    padding: 24px;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: #ffffff;
    box-shadow: 12px 16px 32px rgba(15, 23, 42, 0.12);
    visibility: hidden;
    pointer-events: none;
    transform: translateX(-110%);
    transition:
      transform 360ms cubic-bezier(0.22, 0.61, 0.36, 1),
      visibility 0s linear 360ms;
  }

  .site-header.is-compact.is-scrolled .header-menu {
    top: 68px;
  }

  .site-header.is-compact.is-menu-open .header-menu {
    visibility: visible;
    pointer-events: auto;
    transform: translateX(0);
    transition-delay: 0s;
  }

  .site-header.is-compact .site-nav {
    display: grid;
    gap: 4px;
    width: 100%;
  }

  .site-header.is-compact .nav-link {
    min-height: 48px;
    padding: 12px 16px 12px 22px;
  }

  .site-header.is-compact .header-actions {
    align-items: stretch;
    flex-direction: column;
    gap: 16px;
    padding-bottom: 14px;
  }

  .site-header.is-phone {
    min-height: 72px;
  }

  .site-header.is-phone.is-scrolled {
    --header-collapse: 8px;
  }

  .site-header.is-phone .header-inner {
    min-height: 72px;
  }

  .site-header.is-phone.is-scrolled .header-inner {
    min-height: 64px;
  }

  .site-header.is-phone .nav-toggle {
    top: 14px;
  }

  .site-header.is-phone .brand-logo {
    width: 44px;
  }

  .site-header.is-phone .header-menu {
    top: 72px;
  }

  .site-header.is-phone.is-scrolled .header-menu {
    top: 64px;
  }

  .site-header.is-phone .button {
    width: 100%;
  }

  .site-header.is-tiny .brand-logo {
    width: 44px;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .site-header::before,
    .site-header::after,
    .header-inner,
    .brand-logo,
    .nav-link,
    .nav-link::before,
    .nav-link::after,
    .site-nav,
    .site-header.is-compact .header-menu,
    .nav-toggle-line {
      animation: none;
      transition: none;
    }
  }
</style>
