---
const navItems = [
  { label: "Каталог", href: "/catalog/" },
  { label: "О компании", href: "/#about" },
  { label: "Поставка", href: "/#delivery" },
  { label: "Гарантия", href: "/#warranty" },
  { label: "Контакты", href: "/contacts/" },
];
---

<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Alageum, на главную">
      <img class="brand-logo" src="/images/alageum-logo.png" alt="Alageum Electric" />
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-navigation"
      data-nav-toggle
    >
      <span class="sr-only">Открыть меню</span>
      <span class="nav-toggle-line" aria-hidden="true"></span>
      <span class="nav-toggle-line" aria-hidden="true"></span>
      <span class="nav-toggle-line" aria-hidden="true"></span>
    </button>

    <nav class="site-nav" id="site-navigation" aria-label="Основная навигация" data-site-nav>
      {navItems.map((item) => <a class="nav-link" href={item.href}>{item.label}</a>)}
    </nav>

    <div class="header-actions">
      <a class="phone-link" href="tel:+74957499103">+7 (495) 74-99-103</a>
      <a class="quote-link" href="/contacts/">
        <span>Запросить КП</span>
      </a>
    </div>
  </div>

</header>

<script>
  const header = document.querySelector("[data-site-header]");
  const toggle = document.querySelector("[data-nav-toggle]");
  const nav = document.querySelector("[data-site-nav]");

  const setScrolledState = () => {
    header?.classList.toggle("is-scrolled", window.scrollY > 12);
  };

  const setViewportState = () => {
    if (!header) {
      return;
    }

    const width = window.innerWidth;

    header.classList.toggle("is-compact", width <= 1040);
    header.classList.toggle("is-phone", width <= 640);
    header.classList.toggle("is-tiny", width <= 420);

    if (toggle instanceof HTMLElement) {
      if (width <= 1040) {
        toggle.style.display = "inline-flex";
        toggle.style.position = "fixed";
        toggle.style.top = width <= 640 ? "14px" : "20px";
        toggle.style.right = "12px";
        toggle.style.width = "44px";
        toggle.style.height = "44px";
        toggle.style.border = "1px solid #cbd5e1";
        toggle.style.borderRadius = "8px";
        toggle.style.background = "#ffffff";
        toggle.style.color = "#0f172a";
        toggle.style.flexDirection = "column";
        toggle.style.alignItems = "center";
        toggle.style.justifyContent = "center";
        toggle.style.zIndex = "80";
      } else {
        toggle.removeAttribute("style");
      }
    }

    if (width > 1040) {
      closeMenu();
    }
  };

  const closeMenu = () => {
    toggle?.setAttribute("aria-expanded", "false");
    header?.classList.remove("is-menu-open");
  };

  setScrolledState();
  setViewportState();
  window.addEventListener("scroll", setScrolledState, { passive: true });
  window.addEventListener("resize", setViewportState);

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isOpen));
    header?.classList.toggle("is-menu-open", !isOpen);
  });

  nav?.addEventListener("click", (event) => {
    if (event.target instanceof HTMLAnchorElement) {
      closeMenu();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeMenu();
    }
  });
</script>

<style>
  .site-header {
    --header-bg: rgba(255, 255, 255, 0.94);
    --header-border-color: rgba(219, 227, 238, 0.72);
    --header-clip: polygon(0 0, 100% 0, 100% 100%, 0 100%);
    --header-edge-opacity: 0;

    position: sticky;
    top: 0;
    z-index: 50;
    isolation: isolate;
    overflow: visible;
    border-bottom: 0;
    background: transparent;
  }

  .site-header::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--header-bg);
    box-shadow: inset 0 -1px var(--header-border-color);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    -webkit-clip-path: var(--header-clip);
    clip-path: var(--header-clip);
    pointer-events: none;
    transition:
      background 180ms ease,
      box-shadow 180ms ease,
      -webkit-clip-path 220ms ease,
      clip-path 220ms ease;
  }

  .site-header::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    z-index: 2;
    height: 17px;
    background: var(--color-industrial-red);
    opacity: var(--header-edge-opacity);
    pointer-events: none;
    -webkit-clip-path: polygon(
      0 0,
      34px 0,
      54px 14px,
      calc(100% - 54px) 14px,
      calc(100% - 34px) 0,
      100% 0,
      100% 1.5px,
      calc(100% - 34.5px) 1.5px,
      calc(100% - 54.5px) 15.5px,
      54.5px 15.5px,
      34.5px 1.5px,
      0 1.5px
    );
    clip-path: polygon(
      0 0,
      34px 0,
      54px 14px,
      calc(100% - 54px) 14px,
      calc(100% - 34px) 0,
      100% 0,
      100% 1.5px,
      calc(100% - 34.5px) 1.5px,
      calc(100% - 54.5px) 15.5px,
      54.5px 15.5px,
      34.5px 1.5px,
      0 1.5px
    );
    transition: opacity 180ms ease;
  }

  .site-header.is-scrolled {
    --header-bg: rgba(255, 255, 255, 0.98);
    --header-border-color: transparent;
    --header-edge-opacity: 1;
    --header-clip: polygon(
      0 0,
      100% 0,
      100% calc(100% - 14px),
      calc(100% - 34px) calc(100% - 14px),
      calc(100% - 54px) 100%,
      54px 100%,
      34px calc(100% - 14px),
      0 calc(100% - 14px)
    );
  }

  .header-inner {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 28px;
    min-height: 84px;
    transition: min-height 180ms ease;
  }

  .site-header.is-scrolled .header-inner {
    min-height: 68px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    color: var(--color-heading);
  }

  .brand-logo {
    flex: 0 0 auto;
    width: 174px;
    height: auto;
    display: block;
  }

  .site-nav {
    position: relative;
    justify-self: center;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 8px 12px;
    color: var(--color-muted);
    font-size: 0.94rem;
    font-weight: 720;
    white-space: nowrap;
    transition: color 160ms ease;
  }

  .nav-link::before {
    content: "";
    position: absolute;
    left: 12px;
    right: auto;
    bottom: 5px;
    width: calc(100% - 24px);
    height: 2px;
    background: var(--color-industrial-red);
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left;
    transition: opacity 160ms ease, transform 180ms ease;
  }

  .nav-link::after {
    content: none;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--color-heading);
  }

  .nav-link:hover::before,
  .nav-link:focus-visible::before {
    opacity: 1;
    transform: scaleX(1);
  }

  .header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 14px;
  }

  .phone-link {
    color: var(--color-heading);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 820;
    white-space: nowrap;
  }

  .phone-link:hover {
    color: var(--color-primary);
  }

  .quote-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    border: 1px solid var(--color-industrial-red);
    border-radius: 0;
    padding: 10px 20px;
    background: var(--color-industrial-red);
    clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
    color: #ffffff;
    font-size: 0.94rem;
    font-weight: 840;
    white-space: nowrap;
    overflow: hidden;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.28);
    transition:
      background 180ms ease,
      color 180ms ease,
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .quote-link::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, transparent 0 34%, rgba(200, 23, 31, 0.18) 42%, transparent 52% 100%);
    transform: translateX(-130%);
    opacity: 0;
  }

  .quote-link::after {
    content: "";
    position: absolute;
    inset: 5px;
    border-top: 1px solid rgba(200, 23, 31, 0.34);
    border-right: 1px solid rgba(200, 23, 31, 0.34);
    clip-path: polygon(0 0, 100% 0, 100% 100%, calc(100% - 12px) 100%, calc(100% - 12px) 12px, 0 12px);
    opacity: 0.78;
    pointer-events: none;
  }

  .quote-link span {
    position: relative;
    z-index: 2;
  }

  .quote-link:hover {
    border-color: var(--color-heading);
    background: var(--color-heading);
    color: #ffffff;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.22), 0 12px 28px rgba(15, 23, 42, 0.18);
    transform: translateY(-1px);
  }

  .quote-link:hover::before {
    animation: cta-pulse 620ms ease;
  }

  .nav-toggle {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    border: 1px solid #cbd5e1;
    border-radius: var(--radius-md);
    background: #ffffff;
    color: var(--color-heading);
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.06);
  }

  .nav-toggle-line {
    display: block;
    width: 18px;
    height: 2px;
    margin: 4px auto;
    border-radius: 999px;
    background: currentColor;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .site-header.is-menu-open .nav-toggle span:nth-child(2) {
    transform: translateY(6px) rotate(45deg);
  }

  .site-header.is-menu-open .nav-toggle span:nth-child(3) {
    opacity: 0;
  }

  .site-header.is-menu-open .nav-toggle span:nth-child(4) {
    transform: translateY(-6px) rotate(-45deg);
  }

  @keyframes cta-pulse {
    0% {
      opacity: 0;
      transform: translateX(-120%);
    }

    30% {
      opacity: 1;
    }

    100% {
      opacity: 0;
      transform: translateX(120%);
    }
  }

  .site-header.is-compact .header-inner {
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    padding-right: 60px;
  }

  .site-header.is-compact {
    --header-clip: none;
    --header-edge-opacity: 0;

    overflow: visible;
  }

  .site-header.is-compact .brand {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
  }

  .site-header.is-compact .nav-toggle {
    position: fixed;
    top: 20px;
    right: 12px;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 80;
  }

  .site-header.is-compact .site-nav {
    grid-column: 1 / -1;
    grid-row: 2;
    justify-self: stretch;
    display: grid;
    gap: 0;
    padding-bottom: 0;
    max-height: 0;
    overflow: hidden;
    border: 0 solid var(--color-border);
    border-radius: var(--radius-md);
    background: #ffffff;
    opacity: 0;
    transform: translateY(-8px);
    transition:
      max-height 220ms ease,
      border-width 220ms ease,
      opacity 180ms ease,
      transform 180ms ease;
  }

  .site-header.is-compact.is-menu-open .site-nav {
    max-height: 320px;
    border-width: 1px;
    opacity: 1;
    transform: translateY(0);
  }

  .site-header.is-compact .nav-link {
    min-height: 48px;
    padding: 12px 16px 12px 22px;
  }

  .site-header.is-compact .nav-link::before {
    left: 0;
    right: auto;
    top: 12px;
    bottom: 12px;
    width: 2px;
    height: auto;
    transform: scaleY(0);
    transform-origin: top;
    background: var(--color-industrial-red);
  }

  .site-header.is-compact .nav-link::after {
    content: "";
    position: absolute;
    left: 7px;
    top: 50%;
    bottom: auto;
    width: 6px;
    height: 6px;
    border: 1px solid var(--color-industrial-red);
    background: #ffffff;
    opacity: 0;
    transform: translate(-8px, -50%) rotate(45deg) scale(0.68);
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .site-header.is-compact .nav-link:hover::before,
  .site-header.is-compact .nav-link:focus-visible::before {
    opacity: 1;
    transform: scaleY(1);
  }

  .site-header.is-compact .nav-link:hover::after,
  .site-header.is-compact .nav-link:focus-visible::after {
    opacity: 1;
    transform: translate(0, -50%) rotate(45deg) scale(1);
  }

  .site-header.is-compact .header-actions {
    grid-column: 1 / -1;
    grid-row: 3;
    justify-content: space-between;
    padding-bottom: 14px;
  }

  .site-header.is-phone .header-inner {
    min-height: 72px;
  }

  .site-header.is-phone.is-scrolled .header-inner {
    min-height: 64px;
  }

  .site-header.is-phone .nav-toggle {
    top: 14px;
  }

  .site-header.is-phone .brand-logo {
    width: 148px;
  }

  .site-header.is-phone .header-actions {
    display: none;
    align-items: stretch;
    flex-direction: column;
    gap: 10px;
    padding-bottom: 14px;
  }

  .site-header.is-phone.is-menu-open .header-actions {
    display: flex;
  }

  .site-header.is-phone .quote-link {
    width: 100%;
  }

  .site-header.is-tiny .brand-logo {
    width: 132px;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .site-header::before,
    .site-header::after,
    .header-inner,
    .brand-logo,
    .nav-link,
    .nav-link::before,
    .nav-link::after,
    .quote-link,
    .quote-link::before,
    .quote-link::after,
    .site-nav,
    .nav-toggle-line {
      animation: none;
      transition: none;
    }
  }
</style>
