---
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-inner">
    <div class="hero-copy">
      <div class="hero-copy-intro" aria-hidden="true">
        <img
          src="/images/alageum_logo_full_canvas_transparent.png"
          alt=""
          loading="eager"
          decoding="async"
        />
      </div>

      <div class="hero-copy-content">
        <h1 id="hero-title" aria-label="Энергия индустрии">
          <span class="hero-title-red">Энергия</span>
          <span class="hero-title-plain">индустрии</span>
        </h1>
        <p class="hero-lead">
          Подберём трансформаторы и подстанционное оборудование под проект, подготовим
          коммерческое предложение и организуем поставку по России.
        </p>
        <div class="hero-actions" aria-label="Основные действия">
          <a class="hero-button hero-button-primary" href="/contacts/">Запросить КП</a>
          <a class="hero-button hero-button-secondary" href="/catalog/">Смотреть каталог</a>
        </div>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="hero-visual-panel">
        <div class="hero-visual-frame"></div>
        <img
          src="/images/transformer_hero_transparent_cropped.png"
          alt=""
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    height: calc(100vh - 85px);
    height: calc(100svh - 85px);
    min-height: 0;
    padding: clamp(12px, 1.4vw, 20px) 0;
    background: var(--color-bg);
  }

  .hero-inner {
    width: 100%;
    margin: 0;
    padding-inline: clamp(12px, 1.45vw, 24px);
    height: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: stretch;
    gap: clamp(12px, 1.25vw, 20px);
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    height: 100%;
    min-height: 0;
    padding: clamp(20px, 3vw, 48px) clamp(22px, 3.5vw, 64px);
  }

  .hero-copy-intro {
    --hero-intro-offset: clamp(14px, 2.2vw, 34px);

    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
    padding: inherit;
    pointer-events: none;
    animation: hero-intro-dissolve 800ms cubic-bezier(0.2, 0.65, 0.2, 1) 2200ms forwards;
  }

  .hero-copy-intro img {
    position: relative;
    z-index: 2;
    width: min(calc(96% - var(--hero-intro-offset)), 610px);
    max-height: 36vh;
    margin-left: var(--hero-intro-offset);
    object-fit: contain;
    filter: drop-shadow(0 16px 30px rgba(15, 23, 42, 0.14));
    animation:
      hero-intro-logo-hold 2200ms cubic-bezier(0.2, 0.65, 0.2, 1) both,
      hero-intro-logo-dissolve 720ms ease 2200ms forwards;
  }

  .hero-copy-content {
    position: relative;
    z-index: 1;
    visibility: hidden;
    opacity: 0;
    transform: translateY(14px);
    animation: hero-content-reveal 850ms cubic-bezier(0.2, 0.65, 0.2, 1) 2920ms forwards;
  }

  .hero h1 {
    position: relative;
    width: 100%;
    max-width: 680px;
    margin: 0;
    color: var(--color-heading);
    font-size: clamp(3.1rem, 6vw, 7.2rem);
    font-weight: 920;
    line-height: 0.84;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .hero h1 span {
    display: block;
    max-width: 100%;
  }

  .hero-title-red {
    color: var(--color-industrial-red);
  }

  .hero-title-dark {
    margin-top: 0.06em;
    color: var(--color-heading);
    font-weight: inherit;
  }

  .hero-title-plain {
    margin-top: 0.08em;
    color: var(--color-heading);
  }

  .hero-lead {
    max-width: 600px;
    margin: 22px 0 0;
    color: #3b4453;
    font-size: clamp(1.02rem, 1.5vw, 1.18rem);
    line-height: 1.62;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 28px;
  }

  .hero-button {
    --button-cut: 12px;
    --button-inner-cut: 10px;

    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 13px 22px;
    border: 1px solid transparent;
    overflow: hidden;
    clip-path: polygon(
      var(--button-cut) 0,
      100% 0,
      100% calc(100% - var(--button-cut)),
      calc(100% - var(--button-cut)) 100%,
      0 100%,
      0 var(--button-cut)
    );
    font-size: 0.95rem;
    font-weight: 820;
    transition:
      background 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .hero-button:hover,
  .hero-button:focus-visible {
    transform: translateY(-1px);
  }

  .hero-button-primary {
    background: var(--color-industrial-red);
    color: #ffffff;
  }

  .hero-button-primary:hover,
  .hero-button-primary:focus-visible {
    background: var(--color-heading);
  }

  .hero-button-secondary {
    border-color: transparent;
    background: transparent;
    color: var(--color-heading);
    box-shadow: none;
  }

  .hero-button-secondary::before,
  .hero-button-secondary::after {
    content: "";
    position: absolute;
    pointer-events: none;
    transition: background 180ms ease;
  }

  .hero-button-secondary::before {
    inset: 0;
    z-index: -2;
    background: var(--color-heading);
  }

  .hero-button-secondary::after {
    inset: 2px;
    z-index: -1;
    background: #ffffff;
    clip-path: polygon(
      var(--button-inner-cut) 0,
      100% 0,
      100% calc(100% - var(--button-inner-cut)),
      calc(100% - var(--button-inner-cut)) 100%,
      0 100%,
      0 var(--button-inner-cut)
    );
  }

  .hero-button-secondary:hover,
  .hero-button-secondary:focus-visible {
    background: var(--color-heading);
    color: #ffffff;
  }

  .hero-button-secondary:hover::after,
  .hero-button-secondary:focus-visible::after {
    background: var(--color-heading);
  }

  .hero-visual {
    position: relative;
    min-width: 0;
    height: 100%;
    min-height: 0;
  }

  .hero-visual-panel {
    position: absolute;
    isolation: isolate;
    inset: 0;
    overflow: visible;
  }

  .hero-visual-frame {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: var(--color-industrial-red);
    clip-path: polygon(
      0 42px,
      42px 0,
      calc(100% - 64px) 0,
      100% 64px,
      100% calc(100% - 54px),
      calc(100% - 54px) 100%,
      52px 100%,
      0 calc(100% - 52px)
    );
  }

  .hero-visual-frame::before,
  .hero-visual-frame::after {
    content: "";
    position: absolute;
    left: -12%;
    z-index: 1;
    width: 124%;
    height: 22px;
    pointer-events: none;
    background:
      linear-gradient(
        90deg,
        transparent 0%,
        transparent 18%,
        rgba(255, 255, 255, 0.92) 28%,
        #38bdf8 34%,
        #ffffff 39%,
        rgba(37, 99, 235, 0.32) 46%,
        transparent 62%
      ),
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.12),
        rgba(255, 255, 255, 0.58) 48%,
        rgba(15, 23, 42, 0.22)
      );
    background-position:
      -340px 50%,
      0 50%;
    background-size:
      340px 2px,
      100% 2px;
    background-repeat: no-repeat;
    filter: none;
    opacity: 0.72;
    transform: rotate(-11deg);
    transform-origin: left center;
    transition:
      opacity 180ms ease,
      filter 180ms ease;
  }

  .hero-visual-frame::before {
    top: calc(12% - 11px);
  }

  .hero-visual-frame::after {
    top: calc(12% + 112px - 11px);
    opacity: 0.34;
  }

  .hero-visual-panel:hover .hero-visual-frame::before,
  .hero-visual-panel:hover .hero-visual-frame::after {
    opacity: 0.88;
    background-image:
      radial-gradient(ellipse, rgba(255, 255, 255, 0.78) 0 1px, rgba(56, 189, 248, 0.46) 1.1px 2px, transparent 3.4px),
      radial-gradient(ellipse, rgba(255, 255, 255, 0.52) 0 0.8px, rgba(56, 189, 248, 0.28) 1px 1.8px, transparent 3px),
      linear-gradient(90deg, transparent 0 36%, rgba(255, 255, 255, 0.62) 42% 46%, rgba(56, 189, 248, 0.4) 47% 51%, transparent 58% 100%),
      linear-gradient(
        90deg,
        transparent 0%,
        transparent 18%,
        rgba(255, 255, 255, 0.74) 30%,
        rgba(56, 189, 248, 0.62) 35%,
        rgba(255, 255, 255, 0.78) 40%,
        rgba(37, 99, 235, 0.28) 50%,
        transparent 66%
      ),
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.14),
        rgba(255, 255, 255, 0.62) 46%,
        rgba(56, 189, 248, 0.22) 74%,
        rgba(15, 23, 42, 0.16)
      );
    background-position:
      18% 50%,
      62% 50%,
      42% 50%,
      -340px 50%,
      0 50%;
    background-size:
      72px 8px,
      96px 8px,
      110px 4px,
      340px 2px,
      100% 2px;
    background-repeat:
      no-repeat,
      no-repeat,
      no-repeat,
      no-repeat,
      no-repeat;
    filter:
      drop-shadow(0 0 4px rgba(255, 255, 255, 0.34))
      drop-shadow(0 0 9px rgba(56, 189, 248, 0.36));
    animation: hero-panel-current 1100ms linear infinite;
  }

  .hero-visual-panel:hover .hero-visual-frame::after {
    opacity: 0.78;
    animation-delay: 140ms;
    animation-duration: 1320ms;
  }

  .hero-visual-panel img {
    position: absolute;
    right: 0;
    bottom: calc(-2% + 10px);
    z-index: 2;
    width: min(730px, 100%);
    max-width: none;
    height: auto;
    filter: drop-shadow(0 28px 46px rgba(15, 23, 42, 0.34));
    transform-origin: 56% 58%;
    transition:
      filter 240ms ease,
      transform 280ms cubic-bezier(0.2, 0.65, 0.2, 1);
  }

  .hero-visual-panel:hover img {
    filter: drop-shadow(0 34px 56px rgba(15, 23, 42, 0.4));
    transform: translate(-1.8%, -1.8%) scale(1.04);
  }

  @media (max-width: 1040px) {
    .hero {
      height: auto;
      min-height: auto;
      padding-top: 34px;
    }

    .hero-inner {
      grid-template-columns: 1fr;
      padding-inline: 12px;
    }

    .hero-copy {
      min-height: auto;
      padding: 18px 12px 0;
    }

    .hero-visual {
      min-height: clamp(390px, 67vw, 560px);
    }

    .hero-visual-panel img {
      right: 0;
      bottom: calc(-4% + 10px);
      width: min(620px, 100%);
    }

    .hero-visual-frame::after {
      top: calc(12% + 88px - 11px);
    }

  }

  @media (max-width: 620px) {
    .hero {
      padding: 38px 0 64px;
    }

    .hero h1 {
      font-size: clamp(2.32rem, 9.6vw, 2.68rem);
      line-height: 0.9;
    }

    .hero-lead {
      max-width: 100%;
    }

    .hero-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .hero-button {
      width: 100%;
    }

    .hero-visual {
      min-height: 360px;
    }

    .hero-visual-frame {
      clip-path: polygon(
        0 28px,
        28px 0,
        calc(100% - 38px) 0,
        100% 38px,
        100% calc(100% - 34px),
        calc(100% - 34px) 100%,
        34px 100%,
        0 calc(100% - 34px)
      );
    }

    .hero-visual-panel img {
      right: -1%;
      bottom: calc(2% + 10px);
      width: 104%;
    }

    .hero-visual-frame::before,
    .hero-visual-frame::after {
      left: -18%;
      width: 136%;
    }

    .hero-visual-frame::after {
      top: calc(12% + 66px - 11px);
    }

    .hero-visual-panel:hover img {
      transform: translate(-0.8%, -1%) scale(1.025);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy-intro {
      display: none;
    }

    .hero-copy-content {
      visibility: visible;
      opacity: 1;
      transform: none;
      animation: none;
    }

    .hero-button,
    .hero-visual-panel img {
      transition: none;
    }

    .hero-visual-panel:hover img {
      transform: none;
    }

    .hero-visual-panel:hover .hero-visual-frame::before,
    .hero-visual-panel:hover .hero-visual-frame::after {
      animation: none;
      background-position:
        24% 50%,
        58% 50%,
        40% 50%,
        56% 50%,
        0 50%;
    }
  }

  @keyframes hero-intro-logo-hold {
    from {
      opacity: 0;
      transform: scale(0.985);
    }

    18%,
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes hero-intro-logo-dissolve {
    from {
      opacity: 1;
      transform: scale(1);
    }

    62% {
      opacity: 0.72;
      transform: scale(1.055);
      filter: drop-shadow(0 22px 44px rgba(15, 23, 42, 0.08));
    }

    to {
      opacity: 0;
      transform: scale(1.085);
      filter: drop-shadow(0 26px 52px rgba(15, 23, 42, 0));
    }
  }

  @keyframes hero-intro-dissolve {
    70% {
      opacity: 0;
    }

    to {
      visibility: hidden;
      opacity: 0;
    }
  }

  @keyframes hero-content-reveal {
    from {
      visibility: visible;
      opacity: 0;
      transform: translateY(14px);
    }

    to {
      visibility: visible;
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-panel-current {
    from {
      background-position:
        18% 50%,
        62% 50%,
        42% 50%,
        -340px 50%,
        0 50%;
    }

    48% {
      background-position:
        34% 50%,
        72% 50%,
        54% 50%,
        48% 50%,
        0 50%;
    }

    to {
      background-position:
        50% 50%,
        82% 50%,
        66% 50%,
        calc(100% + 340px) 50%,
        0 50%;
    }
  }
</style>
