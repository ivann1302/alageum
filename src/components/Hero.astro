---
const stats = [
  { value: "30+", label: "предприятий в структуре" },
  { value: "12", label: "действующих заводов" },
  { value: "4 500", label: "сотрудников" },
  { value: "2", label: "проектных и инженерных центра" },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-transformer" aria-hidden="true">
    <img src="/images/hero-substation-background-v2.webp" width="1774" height="887" fetchpriority="high" alt="" loading="eager" decoding="async" />
  </div>
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="hero-brand"><span>ТД</span> А-Транс</p>
      <h1 id="hero-title"><span>Трансформируем</span><span class="hero-title-outline">энергию</span></h1>
      <p class="hero-lead">Трансформаторное и подстанционное оборудование для промышленных объектов</p>
      <div class="hero-actions" aria-label="Основные действия">
        <a class="hero-button hero-button-primary" href="/contacts/">Получить консультацию</a>
      </div>
    </div>
    <div class="hero-facts">
      <dl class="hero-stats">
        {stats.map((stat) => (
          <div class="hero-stat">
            <dt>{stat.label}</dt>
            <dd><span class="sr-only">{stat.value}</span><span data-count-up aria-hidden="true">{stat.value}</span></dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>(".hero");
  let previousWidth = 0;
  const setHeroViewport = () => {
    if (!hero || (previousWidth === window.innerWidth && previousWidth !== 0)) return;
    previousWidth = window.innerWidth;
    const height = window.visualViewport?.height ?? window.innerHeight;
    hero.style.setProperty("--hero-viewport", `${height}px`);
  };
  setHeroViewport();
  window.addEventListener("resize", setHeroViewport, { passive: true });
</script>

<style>
  .hero {
    padding-top: 84px;
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: #f3f4f3;
    color: #090909;
  }

  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(0deg, rgba(255, 255, 255, 0.35), transparent 30%), linear-gradient(90deg, rgba(255, 255, 255, 0.22), transparent 60%);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: clamp(620px, calc(100svh - 84px), 920px);
    padding-block: clamp(42px, 5vw, 72px) 38px;
  }

  .hero-brand {
    margin: 0 0 24px;
    font-size: 1.05rem;
    font-weight: 950;
    text-transform: uppercase;
  }

  .hero-brand span { color: #e30620; }

  .hero h1 {
    margin: 0;
    color: #e30620;
    font-size: clamp(3rem, 6.2vw, 5.7rem);
    font-weight: 950;
    line-height: 0.96;
    letter-spacing: -0.045em;
    text-transform: uppercase;
  }

  .hero h1 span { display: block; }

  .hero h1 .hero-title-outline {
    margin-top: 6px;
    color: transparent;
    -webkit-text-stroke: 2px #090909;
  }

  .hero-lead {
    max-width: 340px;
    margin: 42px 0 0;
    font-size: 1.05rem;
    font-weight: 750;
    line-height: 1.4;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 20px;
  }

  .hero-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 13px 22px;
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 750;
    transition: background-color 180ms ease;
  }

  .hero-button-primary { background: #e30620; }
  .hero-button-primary:hover { background: #aa0015; }

  .hero-transformer {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero-transformer img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: right center;
    filter: contrast(1.18) brightness(0.96);
  }

  .hero-facts { margin-top: 64px; }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(20px, 5vw, 80px);
    max-width: 1050px;
    margin: 0;
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
  }

  .hero-stat dd {
    order: -1;
    margin: 0;
    color: #e30620;
    font-size: clamp(2.5rem, 4.2vw, 4.3rem);
    font-weight: 950;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .hero-stat dt {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 40px;
    padding: 6px 12px;
    background: #e30620;
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 650;
    line-height: 1.15;
  }

  @media (max-width: 640px) {
    .hero { padding-top: 72px; background: var(--color-bg); }
    .hero-inner { width: 100%; min-height: 0; padding-block: 0; }
    .hero-copy {
      display: flex;
      flex-direction: column;
      align-items: center;
      align-self: center;
      width: calc(100% - 24px);
      min-height: calc(var(--hero-viewport, 100svh) - 72px);
      padding-block: 28px calc(48px + env(safe-area-inset-bottom, 0px));
      margin-inline: auto;
      text-align: center;
    }
    .hero-brand { margin-bottom: 22px; font-size: 0.9rem; }
    .hero h1 { width: 100%; font-size: 6.9vw; letter-spacing: -0.055em; text-align: center; }
    .hero h1 .hero-title-outline { font-size: 13vw; -webkit-text-stroke-width: 1.2px; }
    .hero-lead { max-width: 280px; margin: 26px auto 0; font-size: 0.95rem; text-wrap: balance; }
    .hero-actions { width: 100%; justify-content: center; margin-top: auto; padding-top: 32px; }
    .hero-button { width: 100%; padding-inline: 18px; }
    .hero-transformer img { object-position: 60% top; }
    .hero-transformer { bottom: auto; height: var(--hero-viewport, 100svh); }
    .hero::after { background: none; }
    .hero-facts { margin-top: 0; padding: 32px 12px 0; }
    .hero-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 24px; }
    .hero-stat dd { font-size: 2.6rem; }
  }

  @media (max-width: 640px) and (max-height: 600px) {
    .hero-transformer img { object-position: 56% top; }
    .hero-copy { padding-top: 16px; }
    .hero-brand { margin-bottom: 12px; }
    .hero-lead { margin-top: 16px; }
    .hero-actions { padding-top: 20px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-button { transition: none; }
  }
</style>
