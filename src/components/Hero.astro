---
import { withBasePath } from "../lib/paths";
import { managerMaxUrl } from "../data/contact";

const stats = [
  { value: "30+", label: "предприятий в структуре" },
  { value: "12", label: "действующих заводов" },
  { value: "4 500", label: "сотрудников" },
  { value: "2", label: "проектных и инженерных центра" },
];
---

<section class="hero" aria-labelledby="hero-title">
  <svg class="hero-outline-filter" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <!-- Outline the filled glyph silhouette, including overlapping font contours. -->
      <filter id="hero-text-outline" x="-5%" y="-20%" width="110%" height="140%" color-interpolation-filters="sRGB">
        <feMorphology in="SourceAlpha" operator="dilate" radius="1" result="expanded" />
        <feComposite in="expanded" in2="SourceAlpha" operator="out" result="outline" />
        <feFlood flood-color="#090909" />
        <feComposite in2="outline" operator="in" />
      </filter>
    </defs>
  </svg>
  <div class="hero-transformer" data-parallax aria-hidden="true">
    <img src={withBasePath("images/hero-substation-background-v2.webp")} width="1774" height="887" fetchpriority="high" alt="" loading="eager" decoding="async" />
  </div>
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="hero-brand"><span>Торговый Дом</span> А-Транс</p>
      <h1 id="hero-title"><span>Трансформируем</span><span class="hero-title-outline">энергию</span></h1>
      <p class="hero-lead">
        <span class="hero-lead-line">Трансформаторное и подстанционное</span>
        <span class="hero-lead-line">оборудование для промышленных объектов</span>
      </p>
      <div class="hero-actions" aria-label="Основные действия">
        <a class="hero-button hero-button-primary" href={managerMaxUrl} target="_blank" rel="noopener noreferrer">Получить консультацию</a>
      </div>
    </div>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>(".hero");
  let previousWidth = 0;
  const setHeroViewport = () => {
    if (!hero || (previousWidth === window.innerWidth && previousWidth !== 0)) return;
    previousWidth = window.innerWidth;
    const height = window.visualViewport?.height ?? window.innerHeight;
    hero.style.setProperty("--hero-viewport", `${height}px`);
  };
  setHeroViewport();
  window.addEventListener("resize", setHeroViewport, { passive: true });
</script>

<style>
  .hero {
    padding-top: 84px;
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: #f3f4f3;
    color: #090909;
  }

  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(0deg, rgba(255, 255, 255, 0.35), transparent 30%), linear-gradient(90deg, rgba(255, 255, 255, 0.22), transparent 60%);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: clamp(620px, calc(100svh - 84px), 920px);
    padding-block: clamp(42px, 5vw, 72px) 38px;
  }

  .hero-brand {
    margin: 0 0 24px;
    font-size: 1.05rem;
    font-weight: 950;
    text-transform: uppercase;
  }

  .hero-brand span { color: #e30620; }

  .hero h1 {
    margin: 0;
    color: #e30620;
    font-size: clamp(3rem, 6.2vw, 5.7rem);
    font-weight: 950;
    line-height: 0.96;
    letter-spacing: -0.045em;
    text-transform: uppercase;
  }

  .hero h1 span { display: block; }
  .hero-outline-filter { position: absolute; }

  .hero h1 .hero-title-outline {
    margin-top: 6px;
    color: #090909;
    font-weight: 800;
    letter-spacing: 0.02em;
    filter: url(#hero-text-outline);
  }

  .hero-lead {
    color: rgb(9 9 9 / 90%);
    max-width: 420px;
    margin: 42px 0 0;
    font-size: 1.05rem;
    font-weight: 750;
    line-height: 1.4;
  }

  .hero-lead-line { display: block; white-space: nowrap; }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 20px;
  }

  .hero-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 13px 22px;
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 750;
    transition: background-color 180ms ease;
  }

  .hero-button-primary { background: #e30620; }
  .hero-button-primary:hover { background: #aa0015; }

  .hero-transformer {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero-transformer img {
    position: absolute;
    inset: calc(-1 * var(--parallax-space, 0px)) 0 auto;
    display: block;
    width: 100%;
    height: calc(100% + 2 * var(--parallax-space, 0px));
    max-width: none;
    object-fit: cover;
    object-position: right center;
    filter: contrast(1.18) brightness(0.96);
  }

  @media (max-width: 640px) {
    .hero {
      --hero-mobile-height: min(var(--hero-viewport, 100svh), 100svh);
      padding-top: 72px;
      background: var(--color-bg);
    }
    .hero-inner { width: 100%; min-height: 0; padding-block: 0; }
    .hero-copy {
      display: flex;
      flex-direction: column;
      align-items: center;
      align-self: center;
      width: calc(100% - 48px);
      min-height: calc(var(--hero-mobile-height) - 72px);
      padding-block: 20px calc(48px + env(safe-area-inset-bottom, 0px));
      margin-inline: auto;
      text-align: center;
    }
    .hero-brand { margin-bottom: 22px; font-size: 0.9rem; }
    .hero h1 { width: 100%; font-size: 6.9vw; letter-spacing: -0.055em; text-align: center; }
    .hero h1 .hero-title-outline { font-size: 13vw; font-weight: 950; }
    .hero-lead { max-width: 280px; margin: 18px auto 0; font-size: 0.95rem; text-wrap: balance; }
    .hero-lead-line { display: inline; white-space: normal; }
    .hero-actions { width: 100%; justify-content: center; margin-top: auto; padding-top: 32px; }
    .hero-button { width: 100%; padding-inline: 18px; }
    .hero-transformer img { object-position: 60% top; }
    .hero-transformer { bottom: auto; height: var(--hero-mobile-height); }
    .hero::after { background: none; }
  }

  @media (max-width: 640px) and (max-height: 600px) {
    .hero-transformer img { object-position: 56% top; }
    .hero-copy { padding-top: 8px; }
    .hero-brand { margin-bottom: 12px; }
    .hero-lead { margin-top: 8px; }
    .hero-actions { padding-top: 20px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-button { transition: none; }
  }
</style>
