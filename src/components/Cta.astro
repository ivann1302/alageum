---
import { withBasePath } from "../lib/paths";
---

<section class="cta-section" aria-labelledby="cta-title">
  <div class="cta-content">
    <div class="cta-copy" data-reveal="panel">
      <h2 class="section-title" id="cta-title">Подберём оборудование под ваш проект</h2>
      <p>
        Пришлите спецификацию, опросный лист или краткое описание задачи — подготовим
        предложение по трансформаторам и КТП Alageum Electric.
      </p>
    </div>

    <div class="cta-actions" aria-label="Действия" data-reveal="item" style="--reveal-delay: 90ms;">
      <a class="button" href={withBasePath("contacts/")}>Запросить КП</a>
      <a class="button button-outline" href={withBasePath("catalog/")}>Перейти в каталог</a>
    </div>
  </div>
  <div class="cta-visual">
    <img src={withBasePath("images/cta-substation.webp")} alt="Оборудование электрической подстанции" width="1254" height="1254" loading="lazy" decoding="async" />
  </div>
</section>

<style>
  .cta-section { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); width: 100%; overflow: clip; margin: var(--space-section) 0 0; background: var(--color-primary); color: #fff; }
  .cta-content { min-width: 0; padding: clamp(48px, 6vw, 96px) clamp(32px, 5vw, 80px); padding-left: max(32px, calc((100vw - var(--container-width)) / 2)); }
  .cta-copy { max-width: 740px; min-width: 0; }
  .cta-copy h2 { margin: 0; color: #fff; }
  .cta-copy p { max-width: 600px; margin: 24px 0 0; line-height: 1.7; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .cta-actions .button { background: #fff; border-color: #fff; color: var(--color-heading); }
  .cta-actions .button-outline { background: transparent; color: #fff; }
  .cta-actions .button:hover { background: var(--color-heading); border-color: var(--color-heading); color: #fff; }
  .cta-visual { position: relative; min-width: 0; }
  .cta-visual img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  @media (max-width: 640px) {
    .cta-section { grid-template-columns: minmax(0, 1fr); }
    .cta-content { padding: 32px 16px; }
    .cta-copy h2 { font-size: clamp(1.75rem, 7.8vw, 2.6rem); line-height: 1.12; }
    .cta-copy p { margin-top: 20px; font-size: 0.875rem; line-height: 1.6; }
    .cta-actions { flex-direction: column; margin-top: 24px; }
    .cta-actions .button { padding: 12px 8px; font-size: 0.8rem; }
    .cta-visual { aspect-ratio: 4 / 3; }
  }
</style>
