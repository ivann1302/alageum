---
---

<section class="cta-section" aria-labelledby="cta-title">
  <div class="container cta-inner">
    <div class="cta-copy" data-reveal="panel">
      <span class="cta-kicker">Запрос КП</span>
      <h2 id="cta-title">Подберём оборудование под ваш проект</h2>
      <p>
        Пришлите спецификацию, опросный лист или краткое описание задачи — подготовим
        предложение по трансформаторам и КТП Alageum Electric.
      </p>
    </div>

    <div class="cta-actions" aria-label="Действия" data-reveal="item" style="--reveal-delay: 90ms;">
      <a class="cta-button cta-button-primary" href="/contacts/">Запросить КП</a>
      <a class="cta-button cta-button-secondary" href="/catalog/">Перейти в каталог</a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    position: relative;
    overflow: clip;
    margin: clamp(44px, 6vw, 84px) 0 0;
    padding: clamp(64px, 8vw, 108px) 0;
    background: var(--color-industrial-red);
    color: #ffffff;
    clip-path: polygon(42px 0, 100% 0, 100% calc(100% - 42px), calc(100% - 42px) 100%, 0 100%, 0 42px);
  }

  .cta-section::before {
    content: "";
    position: absolute;
    left: max(20px, calc((100vw - var(--container-width)) / 2));
    right: max(20px, calc((100vw - var(--container-width)) / 2));
    bottom: 22px;
    height: 1px;
    background: rgba(255, 255, 255, 0.32);
    pointer-events: none;
  }

  .cta-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(34px, 6vw, 86px);
    align-items: end;
  }

  .cta-copy {
    min-width: 0;
    max-width: 830px;
  }

  .cta-kicker {
    display: inline-flex;
    margin-bottom: 18px;
    color: rgba(255, 255, 255, 0.78);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 820;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .cta-copy h2 {
    margin: 0;
    color: #ffffff;
    font-size: clamp(2.15rem, 5vw, 5rem);
    font-weight: 920;
    line-height: 0.92;
    text-transform: uppercase;
  }

  .cta-copy p {
    max-width: 650px;
    margin: 24px 0 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: clamp(1.02rem, 1.5vw, 1.18rem);
    line-height: 1.62;
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: min(100%, 230px);
  }

  .cta-button {
    --cta-button-cut: 12px;
    --cta-button-inner-cut: 10px;

    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 14px 22px;
    border: 1px solid transparent;
    overflow: hidden;
    clip-path: polygon(
      var(--cta-button-cut) 0,
      100% 0,
      100% calc(100% - var(--cta-button-cut)),
      calc(100% - var(--cta-button-cut)) 100%,
      0 100%,
      0 var(--cta-button-cut)
    );
    font-size: 0.95rem;
    font-weight: 860;
    text-align: center;
    transition:
      background 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .cta-button:hover,
  .cta-button:focus-visible {
    transform: translateY(-1px);
  }

  .cta-button-primary {
    background: #ffffff;
    color: var(--color-heading);
  }

  .cta-button-primary:hover,
  .cta-button-primary:focus-visible {
    background: var(--color-heading);
    color: #ffffff;
  }

  .cta-button-secondary {
    border-color: transparent;
    background: transparent;
    color: #ffffff;
  }

  .cta-button-secondary::before,
  .cta-button-secondary::after {
    content: "";
    position: absolute;
    pointer-events: none;
    transition: background 180ms ease;
  }

  .cta-button-secondary::before {
    inset: 0;
    z-index: -2;
    background: #ffffff;
  }

  .cta-button-secondary::after {
    inset: 2px;
    z-index: -1;
    background: var(--color-industrial-red);
    clip-path: polygon(
      var(--cta-button-inner-cut) 0,
      100% 0,
      100% calc(100% - var(--cta-button-inner-cut)),
      calc(100% - var(--cta-button-inner-cut)) 100%,
      0 100%,
      0 var(--cta-button-inner-cut)
    );
  }

  .cta-button-secondary:hover,
  .cta-button-secondary:focus-visible {
    color: var(--color-heading);
  }

  .cta-button-secondary:hover::after,
  .cta-button-secondary:focus-visible::after {
    background: #ffffff;
  }

  @media (max-width: 860px) {
    .cta-section {
      clip-path: polygon(28px 0, 100% 0, 100% calc(100% - 28px), calc(100% - 28px) 100%, 0 100%, 0 28px);
    }

    .cta-inner {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .cta-actions {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  @media (max-width: 560px) {
    .cta-section {
      margin-top: 36px;
      padding: 58px 0 72px;
    }

    .cta-copy h2 {
      font-size: clamp(1.85rem, 8.5vw, 2.65rem);
    }

    .cta-actions {
      flex-direction: column;
    }

    .cta-button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-button {
      transition: none;
    }
  }
</style>
