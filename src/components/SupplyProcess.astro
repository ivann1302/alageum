---
const steps = [
  {
    title: "Расскажите о задаче",
    text: "Отправьте спецификацию или опишите объект и требования к оборудованию.",
  },
  {
    title: "Получите предложение",
    text: "Подберём оборудование, уточним комплектацию и согласуем условия поставки.",
  },
  {
    title: "Согласуйте поставку",
    text: "Уточним сроки, доставку и комплект сопроводительных документов.",
  },
];
---

<section class="supply-process" aria-labelledby="supply-process-title">
  <div class="container">
    <h2 class="section-title" id="supply-process-title">От задачи до поставки</h2>
    <div class="supply-process-grid">
      {steps.map((step) => (
        <div class="supply-process-step">
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .supply-process { margin-top: var(--space-section); }
  .supply-process h2 { margin: 0 0 36px; }
  .supply-process-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 64px; }
  .supply-process-step { position: relative; min-width: 0; }
  .supply-process-step:not(:last-child)::after { content: ""; position: absolute; top: 50%; right: -33px; width: 2px; height: 100%; transform: translateY(-50%); background: var(--color-primary); pointer-events: none; }
  .supply-process-step h3 { margin: 0; color: var(--color-heading); font-size: 1.1rem; font-weight: 750; line-height: 1.35; }
  .supply-process-step p { margin: 12px 0 0; color: var(--color-muted); font-size: 0.95rem; line-height: 1.7; }
  @media (max-width: 768px) {
    .supply-process h2 { margin-bottom: 28px; }
    .supply-process-grid { --process-gap: 48px; grid-template-columns: minmax(0, 1fr); gap: var(--process-gap); }
    .supply-process-step { padding-left: 36px; }
    .supply-process-step::before { content: ""; box-sizing: border-box; position: absolute; top: 6px; left: 8px; width: 12px; height: 12px; border: 2px solid var(--color-primary); border-radius: 50%; background: transparent; pointer-events: none; }
    .supply-process-step:not(:last-child)::after { top: 18px; right: auto; bottom: calc(-1 * var(--process-gap) - 6px); left: 13px; width: 2px; height: auto; transform: none; }
    .supply-process-step p { max-width: 560px; margin-top: 8px; }
  }
</style>
