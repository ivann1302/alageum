---
import { withBasePath } from "../lib/paths";
import { projects } from "../data/projects";

const projectCases = projects.map((project) => ({
  ...project,
  uniqueSupplies: project.supplies.filter((supply, index, supplies) =>
    supplies.findIndex((item) => item.model === supply.model && item.details === supply.details) === index,
  ),
}));
---

<section class="projects-section" id="projects" aria-labelledby="projects-title">
  <div class="container projects-inner" data-projects-gallery>
    <header class="projects-heading" data-reveal="panel">
      <h2 class="section-title" id="projects-title">Наши проекты</h2>
    </header>

    <div class="project-tabs" role="tablist" aria-label="Заказчики реализованных проектов" data-project-tabs hidden>
      {
        projects.map((project, index) => (
          <button
            class="project-tab"
            id={`project-tab-${index}`}
            type="button"
            role="tab"
            aria-controls={`project-case-${index}`}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? "0" : "-1"}
            data-project-tab
          >
            {project.customer}
          </button>
        ))
      }
    </div>

    <div class="project-cases">
      {
        projectCases.map((project, projectIndex) => (
          <article
            class="project-case"
            id={`project-case-${projectIndex}`}
            role="tabpanel"
            aria-labelledby={`project-tab-${projectIndex}`}
            data-project-case
            data-active-photo="0"
          >
            <div class="project-media" data-reveal="panel" data-reveal-from="left">
              <div class="project-stage" aria-live="polite">
                {project.images.map((image) => (
                  <figure class="project-photo" data-project-photo>
                    <img
                      src={withBasePath(image.src)}
                      alt={image.alt}
                      width={image.width}
                      height={image.height}
                      loading="lazy"
                      decoding="async"
                    />
                  </figure>
                ))}

                {project.images.length > 1 && (
                  <div class="project-photo-controls">
                    <button
                      class="project-photo-arrow project-photo-arrow-prev"
                      type="button"
                      aria-label={`Предыдущее фото проекта ${project.customer}`}
                      data-project-photo-prev
                    />
                    <button
                      class="project-photo-arrow project-photo-arrow-next"
                      type="button"
                      aria-label={`Следующее фото проекта ${project.customer}`}
                      data-project-photo-next
                    />
                  </div>
                )}
              </div>
            </div>

            <div class="project-copy-track">
              <div class="project-copy" data-reveal="panel" data-reveal-from="right">
                <h3 class="project-title">{project.customer}</h3>
                <p class="project-type">Поставленное оборудование</p>
                <ul class="project-supplies" aria-label="Состав поставки">
                  {project.supplies.map((supply) => (
                    <li class="project-supply" data-repeat={project.uniqueSupplies.includes(supply) ? undefined : ""}>
                      <div class="project-supply-heading">
                        <h4>{supply.model}</h4>
                      </div>
                      <p class="project-supply-details">{supply.details}</p>
                    </li>
                  ))}
                </ul>
                <details class="project-characteristics">
                  <summary>Характеристики</summary>
                  <div class="project-characteristics-content">
                    {project.uniqueSupplies.map((supply) => (
                      <p><strong>{supply.model}</strong><br />{supply.details}</p>
                    ))}
                  </div>
                </details>
              </div>
            </div>

            {project.images.length > 1 && (
              <div class="project-thumbnails" aria-label={`Фотографии проекта ${project.customer}`}>
                {project.images.map((image, imageIndex) => (
                  <button
                    class="project-thumbnail"
                    type="button"
                    aria-label={`Показать фотографию ${imageIndex + 1} из ${project.images.length}`}
                    aria-pressed={imageIndex === 0 ? "true" : "false"}
                    data-project-thumbnail
                  >
                    <img
                      src={withBasePath(image.src)}
                      alt=""
                      width={image.width}
                      height={image.height}
                      loading="lazy"
                      decoding="async"
                    />
                  </button>
                ))}
              </div>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .projects-section { overflow: clip; padding-top: var(--space-section); }
  .projects-heading { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr); gap: clamp(32px, 7vw, 96px); align-items: end; }
  .projects-heading h2 { max-width: 780px; margin: 0; }

  .project-tabs { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 32px; }
  .project-tabs:not([hidden]) { display: grid; }
  .project-tab { display: block; padding: 16px 18px; border: 0; background: var(--color-bg); color: var(--color-industrial-red); font-size: clamp(0.85rem, 1.1vw, 1rem); font-weight: 900; overflow-wrap: anywhere; line-height: 1.2; text-align: left; text-transform: uppercase; cursor: pointer; transition: background-color 180ms ease, color 180ms ease; }
  .project-tab:hover { color: var(--color-primary-dark); }
  .project-tab[aria-selected="true"] { background: var(--color-industrial-red); color: #ffffff; }

  .project-cases { margin-top: 20px; }
  .project-case { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(320px, 0.75fr); gap: clamp(32px, 4vw, 56px); align-items: start; }
  .project-case[hidden], .project-photo[hidden] { display: none; }
  [data-projects-gallery]:not([data-enhanced]) .project-case + .project-case { margin-top: var(--space-section); }
  .project-media, .project-copy-track, .project-copy { min-width: 0; }
  .project-stage { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; position: relative; overflow: hidden; background: var(--color-border); }
  .project-photo { display: grid; place-items: center; min-width: 0; aspect-ratio: 3 / 2; margin: 0; overflow: hidden; background: #ffffff; }
  .project-photo:only-child { grid-column: 1 / -1; }
  .project-photo img { display: block; width: 100%; height: 100%; min-width: 0; min-height: 0; object-fit: cover; object-position: center; }
  .project-photo-controls { display: none; }

  [data-projects-gallery][data-enhanced] .project-stage { display: block; aspect-ratio: 3 / 2; background: #ffffff; }
  [data-projects-gallery][data-enhanced] .project-photo { position: absolute; inset: 0; width: 100%; height: 100%; aspect-ratio: auto; }
  [data-projects-gallery][data-enhanced] .project-photo-controls { position: absolute; right: 0; bottom: 0; display: grid; grid-template-columns: repeat(2, 48px); align-items: center; background: #ffffff; }
  .project-photo-arrow { display: grid; place-items: center; width: 48px; height: 48px; padding: 0; border: 0; border-radius: 0; background: var(--color-industrial-red); color: #ffffff; cursor: pointer; transition: background-color 180ms ease; }
  .project-photo-arrow::before { content: ""; width: 10px; height: 10px; border-top: 2px solid currentColor; border-right: 2px solid currentColor; }
  .project-photo-arrow-prev::before { margin-left: 4px; transform: rotate(-135deg); }
  .project-photo-arrow-next::before { margin-right: 4px; transform: rotate(45deg); }
  .project-photo-arrow:hover { background: #000000; }

  .project-thumbnails { display: none; }
  [data-projects-gallery][data-enhanced] .project-thumbnails { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(96px, 1fr); gap: 8px; margin-top: 8px; overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: thin; }
  .project-thumbnail { min-width: 0; aspect-ratio: 3 / 2; padding: 0; overflow: hidden; border: 2px solid transparent; border-radius: 0; background: var(--color-surface); cursor: pointer; opacity: 0.58; transition: border-color 180ms ease, opacity 180ms ease; }
  .project-thumbnail img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .project-thumbnail:hover, .project-thumbnail[aria-pressed="true"] { border-color: var(--color-industrial-red); opacity: 1; }

  .project-title { margin: 0; color: var(--color-heading); font-size: clamp(2rem, 3.3vw, 3.4rem); font-weight: 950; line-height: 1; letter-spacing: -0.035em; text-transform: uppercase; overflow-wrap: anywhere; }
  [data-projects-gallery][data-enhanced] .project-title { display: none; }
  .project-type { margin: 14px 0 0; color: var(--color-heading); font-size: 1.05rem; font-weight: 850; line-height: 1.45; text-transform: uppercase; }
  [data-projects-gallery][data-enhanced] .project-type { margin-top: 0; }
  .project-supplies { margin: 20px 0 0; padding: 0; list-style: none; border-top: 1px solid var(--color-border); }
  .project-supply { padding: 14px 0; border-bottom: 1px solid var(--color-border); }
  .project-supply-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .project-supply h4 { min-width: 0; margin: 0; color: var(--color-heading); font-size: 1rem; font-weight: 850; line-height: 1.4; overflow-wrap: anywhere; }
  .project-supply p { margin: 8px 0 0; color: var(--color-muted); font-size: 0.85rem; line-height: 1.55; overflow-wrap: anywhere; }
  .project-characteristics { display: none; }

  @media (min-width: 901px) {
    .project-case { row-gap: 0; }
    .project-copy-track { grid-column: 2; grid-row: 1; align-self: stretch; }
    .project-copy { position: sticky; top: 108px; }
    .project-thumbnails { grid-column: 1; grid-row: 2; }
  }

  @media (max-width: 900px) {
    .projects-heading { grid-template-columns: 1fr; gap: 20px; }
    .project-tabs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .project-case { grid-template-columns: 1fr; gap: 8px; }
    .project-copy-track { grid-row: 1; margin-bottom: 24px; }
    [data-projects-gallery][data-enhanced] .project-thumbnails { grid-row: 3; margin-top: 0; }
    .project-media { grid-row: 2; }
    .project-title { font-size: clamp(2rem, 7vw, 3.2rem); }
    .project-supplies { max-width: 620px; }
  }

  @media (max-width: 640px) {
    .projects-section { padding-bottom: 16px; }
    .project-tabs { position: relative; gap: 8px; margin-top: 22px; padding-bottom: 3px; overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: none; scroll-snap-type: x proximity; }
    .project-tabs:not([hidden]) { display: flex; flex-wrap: nowrap; }
    .project-tabs::-webkit-scrollbar { display: none; }
    .project-tab { flex: 0 0 auto; max-width: min(320px, calc(100vw - 48px)); min-height: 50px; padding: 14px 16px; font-size: 12px; white-space: normal; text-align: center; scroll-snap-align: center; }
    .project-cases { margin-top: 20px; }
    .project-case { gap: 0; }
    .project-media { grid-row: 1; }
    .project-copy-track { grid-row: 3; margin: 22px 0 0; }
    [data-projects-gallery][data-enhanced] .project-thumbnails { grid-row: 2; margin-top: 8px; grid-auto-columns: 76px; gap: 7px; }
    .project-stage, [data-projects-gallery][data-enhanced] .project-stage { aspect-ratio: 3 / 2; }
    [data-projects-gallery][data-enhanced] .project-photo-controls { grid-template-columns: repeat(2, 44px); }
    .project-photo-arrow { width: 44px; height: 44px; }
    .project-type { font-size: 15px; line-height: 1.4; text-align: center; }
    .project-supplies { margin-top: 14px; }
    .project-supply { padding: 13px 0; }
    .project-supply-heading { justify-content: center; }
    .project-supply h4 { font-size: 15px; }
    .project-supply[data-repeat], .project-supply-details { display: none; }
    .project-characteristics { display: block; margin-top: 18px; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
    .project-characteristics summary { position: relative; display: block; padding: 14px 30px; font-size: 14px; font-weight: 700; list-style: none; cursor: pointer; }
    .project-characteristics summary::-webkit-details-marker { display: none; }
    .project-characteristics summary::after { content: "+"; position: absolute; top: 50%; right: 0; transform: translateY(-50%); color: var(--color-industrial-red); font-size: 24px; font-weight: 400; line-height: 1; }
    .project-characteristics[open] summary::after { content: "−"; }
    .project-characteristics-content { padding-bottom: 14px; color: var(--color-muted); font-size: 13px; line-height: 1.55; overflow-wrap: anywhere; }
    .project-characteristics-content p { margin: 8px 0 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-tab, .project-photo-arrow, .project-thumbnail { transition: none; }
  }
</style>
