---
import { withBasePath } from "../lib/paths";
import {
  companyEmail,
  companyEmailHref,
  managerMaxUrl,
  managerPhone,
  managerPhoneHref,
} from "../data/contact";

const currentYear = new Date().getFullYear();

const footerNav = [
  { label: "Каталог", href: withBasePath("catalog/") },
  { label: "О компании", href: withBasePath("#about") },
  { label: "Документация", href: withBasePath("#documentation") },
  { label: "Контакты", href: withBasePath("contacts/") },
];

const legalLinks = [
  { label: "Юридическая информация", href: withBasePath("legal/") },
  { label: "Конфиденциальность", href: withBasePath("legal/#privacy") },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <a class="footer-logo" href={withBasePath()} aria-label="Торговый Дом А-Транс, на главную">
      <img src={withBasePath("images/footer-logo-atrans.png")} alt="Торговый Дом А-Транс" width="360" height="447" loading="lazy" decoding="async" />
    </a>

    <p class="footer-description">
      Трансформаторное и подстанционное оборудование для энергетики,
      промышленности и инфраструктуры.
    </p>

    <nav class="footer-nav" aria-label="Навигация в футере">
      {footerNav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="footer-contact">
      <a class="footer-phone" href={managerPhoneHref}>{managerPhone}</a>
      <a href={companyEmailHref}>{companyEmail}</a>
      <a class="footer-cta" href={managerMaxUrl} target="_blank" rel="noopener noreferrer">Запросить КП</a>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>© {currentYear} ООО «Торговый Дом А-Транс»</span>
    <div class="footer-legal">
      {legalLinks.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>
  </div>
  <div class="footer-mark" aria-hidden="true">Торговый Дом А-Транс</div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: clip;
    margin: 72px 0 0;
    padding: clamp(32px, 3vw, 48px) 0 0;
    background: #000000;
    color: #ffffff;
    text-align: center;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .footer-logo {
    display: block;
    width: clamp(88px, 8vw, 112px);
    margin: 0 auto 16px;
  }

  .footer-logo img { display: block; width: 100%; height: auto; }

  .footer-description {
    max-width: 450px;
    margin: 0 auto;
    text-wrap: balance;
    color: rgb(181 181 181 / 90%);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .footer-nav,
  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 22px;
  }

  .footer-nav {
    margin: 20px auto 0;
    align-items: center;
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin: 20px auto 0;
  }

  .footer-nav a,
  .footer-contact a,
  .footer-legal a {
    color: rgb(181 181 181 / 90%);
    font-size: 0.86rem;
    transition: color 180ms ease;
  }

  .footer-nav a:hover,
  .footer-contact a:hover,
  .footer-legal a:hover {
    color: #ffffff;
  }

  .footer-phone {
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .footer-contact .footer-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    margin-top: 8px;
    padding: 12px 22px;
    background: #ffffff;
    color: #000000;
    font-weight: 750;
    transition: background-color 180ms ease, color 180ms ease;
  }

  .footer-contact .footer-cta:hover {
    background: #e30620;
    color: #ffffff;
  }

  .footer-mark {
    margin: 24px auto 0;
    color: #202020;
    font-size: clamp(2rem, 7.3vw, 8rem);
    font-weight: 950;
    line-height: 0.8;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid #242424;
    color: rgb(153 153 153 / 90%);
    font-size: 0.76rem;
    line-height: 1.6;
  }

  .footer-legal a {
    font-size: inherit;
  }

  @media (max-width: 640px) {
    .site-footer {
      margin: 44px 0 0;
      padding-top: 32px;
    }

    .footer-nav {
      flex-direction: column;
      gap: 8px;
    }

    .footer-description {
      max-width: 300px;
    }

    .footer-legal {
      flex-direction: column;
      align-items: center;
    }

    .footer-mark {
      margin-top: 24px;
      font-size: 7.2vw;
      transform: translateY(-3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-nav a,
    .footer-contact a,
    .footer-legal a {
      transition: none;
    }
  }
</style>
