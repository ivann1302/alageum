---
const faqs = [
  {
    question: "Какое оборудование Alageum Electric можно заказать?",
    answer:
      "Основные направления поставки — масляные и сухие трансформаторы, комплектные трансформаторные подстанции и подстанционное оборудование. В проектных запросах учитываем оборудование для сетей 6, 10, 20, 35 и 110 кВ.",
  },
  {
    question: "Можно ли подобрать трансформатор по техническому заданию?",
    answer:
      "Да. При подборе важны тип оборудования, мощность, напряжение ВН/НН, исполнение, условия установки и требования объекта. Если есть опросный лист, спецификация или проектная документация, их лучше приложить к запросу.",
  },
  {
    question: "Какие данные нужны для коммерческого предложения?",
    answer:
      "Для подготовки КП обычно нужны реквизиты компании, контактное лицо, требуемое оборудование, мощность, напряжение, срок поставки, адрес или регион доставки и файл проекта или спецификации, если он уже есть.",
  },
  {
    question: "Поставляете ли оборудование по России?",
    answer:
      "Да, поставка и логистика согласуются под сроки проекта и особенности промышленного или инфраструктурного объекта. Условия доставки зависят от типа оборудования, комплектации, маршрута и требований к разгрузке.",
  },
  {
    question: "Какие документы сопровождают поставку?",
    answer:
      "Мы готовим коммерческое предложение, техническую информацию для согласования и комплект сопроводительных документов по оборудованию. Наличие сертификатов, деклараций и паспортов зависит от категории и конкретной поставки.",
  },
  {
    question: "Работаете ли с юридическими лицами по безналичному расчёту?",
    answer:
      "Да, сайт ориентирован на B2B-заказчиков: снабжение, проектировщиков, промышленные предприятия, энергетические и инфраструктурные объекты. Условия оплаты и договорные документы уточняются при подготовке предложения.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<section class="faq-section" aria-labelledby="faq-title">
  <div class="container faq-inner">
    <div class="faq-head" data-reveal="panel">
      <h2 class="section-title" id="faq-title" aria-label="Частые вопросы перед заказом">
        <span>Частые вопросы</span>
        {" "}
        <span>перед заказом</span>
      </h2>
      <p>
        Собрали ответы по подбору, документам, доставке и условиям работы с
        трансформаторным оборудованием Alageum Electric.
      </p>
    </div>

    <div class="faq-list" aria-label="Частые вопросы">
      {
        faqs.map((item, index) => (
          <details
            class="faq-item"
            open={index === 0}
            data-reveal="item"
            style={`--reveal-delay: ${Math.min(index * 55, 220)}ms;`}
          >
            <summary>
              <span class="faq-question">{item.question}</span>
              <span class="faq-toggle" aria-hidden="true"></span>
            </summary>
            <div class="faq-answer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
.faq-section { overflow: clip; padding-top: var(--space-section); }
  .faq-inner { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(40px, 7vw, 96px); align-items: start; }
  .faq-head { min-width: 0; }
  .faq-head h2 { margin: 0; }
  .faq-head p { margin: 24px 0 0; color: var(--color-muted); line-height: 1.7; }
  .faq-list { border-top: 1px solid var(--color-border); }
  .faq-item { border-bottom: 1px solid var(--color-border); }
  .faq-item summary { display: grid; grid-template-columns: minmax(0, 1fr) 24px; gap: 20px; align-items: center; padding: 24px 0; cursor: pointer; list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-question { font-size: 1rem; font-weight: 750; line-height: 1.4; transition: color 180ms ease; }
  .faq-item[open] .faq-question, .faq-item summary:hover .faq-question { color: var(--color-industrial-red); }
  .faq-toggle { position: relative; width: 24px; height: 24px; }
  .faq-toggle::before, .faq-toggle::after { content: ""; position: absolute; top: 11px; left: 5px; width: 14px; height: 2px; background: currentColor; }
  .faq-toggle::after { transform: rotate(90deg); transition: transform 180ms ease; }
  .faq-item[open] .faq-toggle::after { transform: rotate(0); }
  .faq-answer { padding: 0 44px 24px 0; }
  .faq-answer p { margin: 0; color: var(--color-muted); font-size: 0.95rem; line-height: 1.7; }
  @media (max-width: 900px) { .faq-inner { grid-template-columns: 1fr; gap: 32px; } }
  @media (max-width: 640px) { .faq-answer { padding-right: 0; } }
  @media (prefers-reduced-motion: reduce) { .faq-question, .faq-toggle::after { transition: none; } }
</style>
